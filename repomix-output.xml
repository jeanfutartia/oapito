import { useEffect, useState } from 'react';
import { useGameStore } from './store/useGameStore';
import { DECISION_LABEL } from './mock/incidentsDatabase';
import { PitchCanvas } from './components/PitchCanvas';
import { VARModal } from './components/VARModal';
import { VARRadioModal } from './components/VARRadioModal';
import { ProfileModal } from './components/ProfileModal';
import { MatchReportModal } from './components/MatchReportModal';
import { MatchHistoryModal } from './components/MatchHistoryModal';
import { ManagerIncidentModal } from './components/ManagerIncidentModal';
import { MatchStatsSidebar } from './components/MatchStatsSidebar';
import { GoalCelebrationOverlay } from './components/GoalCelebrationOverlay';
import { SmartRefereeDashboard } from './components/SmartRefereeDashboard';
import { EquipmentBar } from './components/EquipmentBar';

const fmtMinute = (m: number) => (m > 90 ? `90+${m - 90}` : String(m));

export function App() {
  const [showHistoryModal, setShowHistoryModal] = useState(false);

  const {
    isProfileCreated,
    week,
    referee,
    teams,
    matchHistory,
    nextMatchSchedule,
    currentManagerIncident,
    currentGoalAnimation,
    isEvaluatingPostMatch,
    postMatch,
    homeManagerEjected,
    awayManagerEjected,
    liveStats,
    activeMatch,
    createProfile,
    drawNextSchedule,
    startScheduledMatch,
    clearGoalAnimation,
    updateMatchMinute,
    setMatchSpeed,
    triggerInstantFieldDecision,
    openVarRadioIntercom,
    openVarMonitorOFR,
    confirmFinalDecision,
    resolveManagerIncident,
    finishMatch,
    registerSprayUse,
    resetCareer
  } = useGameStore();

  const hasMatch = !!activeMatch;
  const status = activeMatch?.status;
  const speed = activeMatch?.matchSpeed ?? 1;

  useEffect(() => {
    if (!hasMatch || status !== 'PLAYING' || currentManagerIncident || currentGoalAnimation) return;
    const timer = setInterval(updateMatchMinute, Math.max(120, 1000 / speed));
    return () => clearInterval(timer);
  }, [hasMatch, status, speed, currentManagerIncident, currentGoalAnimation, updateMatchMinute]);

  useEffect(() => {
    if (isProfileCreated && !nextMatchSchedule && !hasMatch) void drawNextSchedule();
  }, [isProfileCreated, nextMatchSchedule, hasMatch, drawNextSchedule]);

  const standings = teams
    .filter(t => t.tier === referee.tier)
    .sort((a, b) => b.points - a.points || b.goalsFor - b.goalsAgainst - (a.goalsFor - a.goalsAgainst));
  const lastMatch = matchHistory[0];

  const handleReset = () => {
    if (window.confirm('Apagar a carreira e começar do zero?')) resetCareer();
  };

  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans">
      {!isProfileCreated && <ProfileModal onSave={createProfile} />}
      {showHistoryModal && <MatchHistoryModal history={matchHistory} onClose={() => setShowHistoryModal(false)} />}

      {currentGoalAnimation && <GoalCelebrationOverlay data={currentGoalAnimation} onClose={clearGoalAnimation} />}

      {currentManagerIncident && <ManagerIncidentModal incident={currentManagerIncident} onResolve={resolveManagerIncident} />}

      {postMatch && activeMatch && !currentGoalAnimation && (
        <MatchReportModal
          homeTeam={activeMatch.homeTeam}
          awayTeam={activeMatch.awayTeam}
          homeScore={activeMatch.homeScore}
          awayScore={activeMatch.awayScore}
          report={postMatch.report}
          uefaScore={postMatch.uefaScore}
          isEvaluating={isEvaluatingPostMatch}
          onSignAndContinue={finishMatch}
        />
      )}

      <header className="bg-slate-900 border-b border-slate-800 px-6 py-3 flex flex-wrap items-center justify-between gap-4">
        <div className="flex items-center gap-3">
          <div className="bg-emerald-600 p-2 rounded-lg text-white font-black text-base leading-none">⚽</div>
          <div>
            <h1 className="text-base font-extrabold tracking-tight">O APITO: SIMULADOR DE ARBITRAGEM</h1>
            <div className="flex items-center gap-2 text-xs text-slate-400">
              <span>{referee.federation}</span>
              <span>•</span>
              <span className="text-emerald-400 font-bold">{referee.tier}</span>
              <span>•</span>
              <span>Rodada {week}</span>
            </div>
          </div>
        </div>

        <div className="flex items-center gap-6 text-xs">
          <div>
            <span className="text-slate-400 block">Árbitro</span>
            <span className="font-bold text-slate-200">{referee.name}</span>
          </div>
          <div>
            <span className="text-slate-400 block">Nota UEFA</span>
            <span className="font-bold text-emerald-400">{referee.uefaAverageScore.toFixed(2)}</span>
          </div>
          <div>
            <span className="text-slate-400 block">Jogos / Reputação</span>
            <span className="font-bold text-amber-400">{referee.stats.matches} • {referee.reputation}</span>
          </div>
          <button onClick={() => setShowHistoryModal(true)} className="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg font-bold border border-slate-700">
            📚 Histórico
          </button>
          <button onClick={handleReset} className="px-3 py-1.5 bg-slate-800 hover:bg-red-900 rounded-lg font-bold border border-slate-700">
            ♻ Nova carreira
          </button>
        </div>
      </header>

      <main className="flex-1 max-w-7xl w-full mx-auto p-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div className="lg:col-span-2 flex flex-col gap-6">
          {activeMatch ? (
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 flex flex-col gap-4 shadow-xl">
              <div className="flex items-center justify-between bg-slate-950 p-4 rounded-lg border border-slate-800">
                <div className="flex flex-col">
                  <span className="font-black text-sm">{activeMatch.homeTeam.name}</span>
                  {activeMatch.homeRedCards > 0 && <span className="text-[11px] text-red-400">🟥 x{activeMatch.homeRedCards}</span>}
                </div>
                <div className="text-center">
                  <span className="text-3xl font-black font-mono">{activeMatch.homeScore} - {activeMatch.awayScore}</span>
                  <span className="block text-xs text-emerald-400 font-mono font-bold">{fmtMinute(activeMatch.minute)}'</span>
                </div>
                <div className="flex flex-col items-end">
                  <span className="font-black text-sm">{activeMatch.awayTeam.name}</span>
                  {activeMatch.awayRedCards > 0 && <span className="text-[11px] text-red-400">🟥 x{activeMatch.awayRedCards}</span>}
                </div>
              </div>

              <PitchCanvas
                isPlaying={activeMatch.status === 'PLAYING'}
                isPausedForKmi={activeMatch.status !== 'PLAYING' && activeMatch.status !== 'FINISHED'}
                temperature={activeMatch.matchTemperature}
                homeRedCards={activeMatch.homeRedCards}
                awayRedCards={activeMatch.awayRedCards}
              />

              <div className="flex items-center justify-between text-xs">
                <span className="text-slate-400 font-mono">Velocidade da partida</span>
                <div className="flex gap-1.5">
                  {[1, 2, 4, 8].map(s => (
                    <button
                      key={s}
                      onClick={() => setMatchSpeed(s)}
                      className={`px-3 py-1 rounded font-bold border ${activeMatch.matchSpeed === s ? 'bg-emerald-600 border-emerald-400 text-white' : 'bg-slate-800 border-slate-700 text-slate-400'}`}
                    >
                      {s}x
                    </button>
                  ))}
                </div>
              </div>

              {activeMatch.status === 'KMI_PAUSED' && activeMatch.currentIncident && (
                <div className="bg-slate-950 border border-amber-500/80 p-5 rounded-lg flex flex-col gap-3 shadow-2xl">
                  <span className="text-xs font-black text-amber-400">⚠️ LANCE CAPITAL ({fmtMinute(activeMatch.currentIncident.minute)}')</span>
                  <p className="text-xs text-slate-200">{activeMatch.currentIncident.description}</p>
                  <p className="text-[11px] text-slate-400 font-mono">
                    Decisão atual em campo: <strong className="text-amber-300">{DECISION_LABEL[activeMatch.currentIncident.fieldDecision]}</strong>. Sem cronômetro: analise com calma.
                  </p>
                  <div className="flex flex-wrap gap-2">
                    <button onClick={openVarRadioIntercom} className="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-500 rounded text-xs font-bold">📻 Rádio VAR</button>
                    <button onClick={openVarMonitorOFR} className="px-3.5 py-2 bg-red-600 hover:bg-red-500 rounded text-xs font-bold">🖥️ Ir ao Monitor (OFR)</button>
                    <button onClick={() => triggerInstantFieldDecision()} className="px-3.5 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded text-xs font-bold">Bancar decisão de campo</button>
                  </div>
                </div>
              )}

              <div className="bg-slate-950 border border-slate-800 rounded-lg p-3 flex flex-col gap-1 font-mono text-[11px] max-h-40 overflow-y-auto">
                {activeMatch.ticker.slice(0, 8).map((line, i) => (
                  <span key={`${i}-${line}`} className={i === 0 ? 'text-amber-300 font-bold' : 'text-slate-400'}>{line}</span>
                ))}
              </div>
            </div>
          ) : (
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-6 flex flex-col gap-5">
              {nextMatchSchedule ? (
                <>
                  <div className="bg-slate-950 p-5 rounded-2xl border border-slate-800 flex flex-wrap justify-between items-center gap-4">
                    <div>
                      <span className="text-[10px] font-black uppercase tracking-wider text-amber-400">Próxima partida • Risco: {nextMatchSchedule.derbyRisk}</span>
                      <h3 className="text-xl font-black text-white">{nextMatchSchedule.home.name} x {nextMatchSchedule.away.name}</h3>
                      <p className="text-xs text-slate-400">{nextMatchSchedule.stadium} • Público previsto: {nextMatchSchedule.attendance.toLocaleString()}</p>
                    </div>
                    <button onClick={startScheduledMatch} className="px-6 py-3 bg-emerald-600 hover:bg-emerald-500 font-bold rounded-xl shadow-lg shadow-emerald-600/30">
                      ▶️ Entrar em Campo
                    </button>
                  </div>
                  <div className="bg-slate-950 p-4 rounded-xl border border-slate-800 text-xs flex flex-col gap-2">
                    <h4 className="font-black text-emerald-400">{nextMatchSchedule.storyline.pressHeadline}</h4>
                    <p className="text-slate-300 italic">{nextMatchSchedule.storyline.homeManagerQuote}</p>
                    <p className="text-slate-300 italic">{nextMatchSchedule.storyline.awayManagerQuote}</p>
                    <p className="text-slate-500">{nextMatchSchedule.storyline.scrutinyContext}</p>
                  </div>
                </>
              ) : (
                isProfileCreated && <div className="text-center text-slate-500 text-xs italic py-8 animate-pulse">Sorteando a próxima escala...</div>
              )}
              {lastMatch && (
                <div className="bg-slate-950 p-3 rounded-xl border border-slate-800 text-xs font-mono flex justify-between">
                  <span className="text-slate-400">Último jogo: {lastMatch.homeTeamName} {lastMatch.homeScore} x {lastMatch.awayScore} {lastMatch.awayTeamName}</span>
                  <span className="text-emerald-400 font-bold">Nota {lastMatch.uefaScore.toFixed(2)}</span>
                </div>
              )}
            </div>
          )}
        </div>

        <div className="flex flex-col gap-6">
          <EquipmentBar />
          {activeMatch ? (
            <>
              <SmartRefereeDashboard bpm={liveStats.refereeBpm} distanceKm={liveStats.distanceCoveredKm} temperature={Math.round(activeMatch.matchTemperature)} onSprayUsed={registerSprayUse} />
              <MatchStatsSidebar homeTeam={activeMatch.homeTeam} awayTeam={activeMatch.awayTeam} stats={liveStats} homeManagerEjected={homeManagerEjected} awayManagerEjected={awayManagerEjected} />
            </>
          ) : (
            <div className="bg-slate-900 border border-slate-800 rounded-xl p-5">
              <h2 className="text-sm font-bold text-slate-100 uppercase mb-3">Tabela de Classificação</h2>
              <div className="space-y-1">
                {standings.map((t, i) => (
                  <div key={t.id} className="flex justify-between text-xs py-1 border-b border-slate-800">
                    <span>{i + 1}. {t.name}</span>
                    <span className="font-bold">{t.points} pts <span className="text-slate-500 font-normal">({t.played}J)</span></span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </main>

      {activeMatch?.status === 'VAR_RADIO' && activeMatch.currentIncident && (
        <VARRadioModal
          incident={activeMatch.currentIncident}
          apiKey={referee.geminiApiKey}
          onGoToOFR={openVarMonitorOFR}
          onKeepFieldDecision={() => triggerInstantFieldDecision()}
        />
      )}

      {activeMatch?.status === 'VAR_ACTIVE' && activeMatch.currentIncident && (
        <VARModal
          incident={activeMatch.currentIncident}
          homeTeam={activeMatch.homeTeam}
          awayTeam={activeMatch.awayTeam}
          onConfirm={confirmFinalDecision}
        />
      )}
    </div>
  );
}

export default App;
