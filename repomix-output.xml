import { useEffect } from 'react';
import confetti from 'canvas-confetti';
import type { GoalAnimationData } from '../types/types';

interface Props {
  data: GoalAnimationData;
  onClose: () => void;
}

const CSS = `
@keyframes ballIn { 0%{transform:translate(-170px,70px) scale(1.8)} 65%{transform:translate(0,0) scale(.85)} 100%{transform:translate(0,8px) scale(.8)} }
@keyframes ballOut { 0%{transform:translate(-170px,70px) scale(1.8)} 55%{transform:translate(-30px,0) scale(.95)} 100%{transform:translate(110px,120px) scale(1.2) rotate(240deg)} }
@keyframes netShake { 0%,60%{transform:scaleX(1)} 70%{transform:scaleX(1.08)} 80%{transform:scaleX(.96)} 90%{transform:scaleX(1.03)} 100%{transform:scaleX(1)} }
@keyframes popIn { 0%{transform:scale(.3);opacity:0} 60%{transform:scale(1.15);opacity:1} 100%{transform:scale(1);opacity:1} }
@keyframes scorePulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.35)} }
`;

export const GoalCelebrationOverlay = ({ data, onClose }: Props) => {
  const isGoal = data.variant === 'GOAL';

  useEffect(() => {
    let id: ReturnType<typeof setInterval> | undefined;
    if (isGoal) {
      const colors = [data.teamColor, '#ffffff', '#facc15'];
      const fire = () =>
        confetti({ particleCount: 70, spread: 85, origin: { x: Math.random() * 0.6 + 0.2, y: 0.6 }, colors });
      fire();
      id = setInterval(fire, 700);
    }
    const timer = setTimeout(onClose, isGoal ? 6500 : 4500);
    return () => {
      if (id) clearInterval(id);
      clearTimeout(timer);
    };
  }, [data, isGoal, onClose]);

  const homeScoring = data.scoringSide === 'HOME' && isGoal;
  const awayScoring = data.scoringSide === 'AWAY' && isGoal;
  const pulse = { animation: 'scorePulse 0.8s ease-in-out 3' };
  const box = { transformBox: 'fill-box' as const, transformOrigin: 'center' };

  return (
    <div onClick={onClose} className="fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center cursor-pointer select-none">
      <style>{CSS}</style>
      <div className={`absolute inset-0 pointer-events-none ${isGoal ? 'bg-gradient-to-t from-emerald-950/50 via-transparent to-amber-950/40' : 'bg-gradient-to-t from-red-950/50 via-transparent to-slate-950/40'}`} />

      <div className="relative z-10 flex flex-col items-center text-center p-6 max-w-2xl w-full gap-4">
        <div className="flex items-center gap-4 bg-slate-950/95 border border-slate-700 rounded-2xl px-6 py-3 shadow-2xl font-mono">
          <span className="flex items-center gap-2 font-black text-sm text-white">
            <span className="w-3 h-3 rounded-full border border-white" style={{ backgroundColor: data.homeColor }} />
            {data.homeShort}
          </span>
          <span className="text-4xl font-black text-white flex items-center gap-3">
            <span style={homeScoring ? pulse : undefined} className={homeScoring ? 'text-amber-300' : ''}>{data.homeScore}</span>
            <span className="text-slate-500">-</span>
            <span style={awayScoring ? pulse : undefined} className={awayScoring ? 'text-amber-300' : ''}>{data.awayScore}</span>
          </span>
          <span className="flex items-center gap-2 font-black text-sm text-white">
            {data.awayShort}
            <span className="w-3 h-3 rounded-full border border-white" style={{ backgroundColor: data.awayColor }} />
          </span>
          <span className="text-xs text-amber-400 font-bold">{data.minute}'</span>
        </div>

        <div className={`${isGoal ? 'bg-amber-500' : 'bg-red-600'} text-black font-black text-xs px-4 py-1 rounded-full uppercase tracking-widest shadow-lg`}>
          {isGoal ? (data.isPenalty ? 'Gol de pênalti' : 'Gol válido') : 'Decisão do VAR'}
        </div>

        <h1
          style={{ animation: 'popIn 0.6s ease-out forwards' }}
          className={`text-6xl sm:text-7xl font-black italic tracking-tighter text-transparent bg-clip-text drop-shadow-[0_10px_25px_rgba(250,204,21,0.5)] ${
            isGoal ? 'bg-gradient-to-r from-yellow-300 via-white to-amber-400' : 'bg-gradient-to-r from-red-400 via-white to-red-500'
          }`}
        >
          {isGoal ? 'GOOOOOOL!' : 'GOL ANULADO'}
        </h1>

        <svg viewBox="0 0 420 210" className="w-full max-w-md">
          <rect x={60} y={30} width={300} height={140} fill="rgba(15,23,42,0.6)" />
          <g style={{ ...box, animation: isGoal ? 'netShake 1.4s ease-out 1' : undefined }}>
            {Array.from({ length: 13 }, (_, i) => (
              <line key={`v${i}`} x1={60 + i * 25} y1={30} x2={60 + i * 25} y2={170} stroke="rgba(255,255,255,0.25)" />
            ))}
            {Array.from({ length: 7 }, (_, i) => (
              <line key={`h${i}`} x1={60} y1={30 + i * 23} x2={360} y2={30 + i * 23} stroke="rgba(255,255,255,0.25)" />
            ))}
          </g>
          <rect x={56} y={26} width={308} height={6} fill="#fff" />
          <rect x={56} y={26} width={6} height={150} fill="#fff" />
          <rect x={358} y={26} width={6} height={150} fill="#fff" />
          <line x1={0} y1={176} x2={420} y2={176} stroke="rgba(255,255,255,0.5)" strokeWidth={2} />
          <g transform="translate(210 100)">
            <g style={{ ...box, animation: `${isGoal ? 'ballIn' : 'ballOut'} 1.2s cubic-bezier(.2,.7,.3,1) forwards` }}>
              <circle r={14} fill="#fff" stroke="#111" strokeWidth={2} />
              <path d="M -5 -4 L 0 -9 L 5 -4 L 3 3 L -3 3 Z" fill="#111" />
            </g>
          </g>
          {!isGoal && (
