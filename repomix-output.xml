// aplicar-melhorias.mjs  ->  na raiz do projeto: node aplicar-melhorias.mjs
import fs from 'node:fs';
import path from 'node:path';

const root = process.cwd();
if (!fs.existsSync(path.join(root, 'package.json')) || !fs.existsSync(path.join(root, 'src'))) {
  console.error('ERRO: rode na raiz do projeto (onde ficam package.json e a pasta src).');
  process.exit(1);
}
const FILES = [
  ["src/App.tsx", "import { useEffect, useState } from 'react';\nimport { useGameStore, EQUIPMENT } from './store/useGameStore';\nimport type { QuickCall, QuickChoice } from './store/useGameStore';\nimport { PitchCanvas } from './components/PitchCanvas';\nimport { VARModal } from './components/VARModal';\nimport { VARRadioModal } from './components/VARRadioModal';\nimport { ProfileModal } from './components/ProfileModal';\nimport { MatchReportModal } from './components/MatchReportModal';\nimport { MatchHistoryModal } from './components/MatchHistoryModal';\nimport { ManagerIncidentModal } from './components/ManagerIncidentModal';\nimport { MatchStatsSidebar } from './components/MatchStatsSidebar';\nimport { GoalCelebrationOverlay } from './components/GoalCelebrationOverlay';\nimport { SmartRefereeDashboard } from './components/SmartRefereeDashboard';\n\nconst TWISTS = ['Invas\u00e3o de campo por torcedor', 'Confus\u00e3o generalizada entre jogadores', 'Objetos arremessados da arquibancada'];\nconst TRAINING = [\n  { id: 'PHYSICAL', label: '\ud83c\udfc3 F\u00edsico', hint: '+3 condi\u00e7\u00e3o f\u00edsica' },\n  { id: 'RULES', label: '\ud83d\udcd6 Regras', hint: '+3 conhecimento' },\n  { id: 'PSYCHOLOGY', label: '\ud83e\udde0 Psicologia', hint: '+3 resist\u00eancia, +1 autoridade' },\n  { id: 'REST', label: '\ud83d\ude34 Descanso', hint: '+1 f\u00edsico, +2 resist\u00eancia' }\n] as const;\n\nconst Bar = ({ label, value }: { label: string; value: number }) => (\n  <div className=\"flex items-center gap-2 text-[11px]\">\n    <span className=\"w-28 text-slate-400\">{label}</span>\n    <div className=\"flex-1 h-1.5 bg-slate-800 rounded-full overflow-hidden\">\n      <div className=\"h-full bg-emerald-500 transition-all\" style={{ width: value + '%' }} />\n    </div>\n    <span className=\"w-7 text-right font-mono text-slate-300\">{value}</span>\n  </div>\n);\n\nconst CALL_OPTIONS: { id: QuickChoice; label: string; cls: string }[] = [\n  { id: 'PLAY_ON', label: 'Seguir', cls: 'bg-slate-800 border-slate-600 hover:bg-slate-700' },\n  { id: 'ADVANTAGE', label: 'Vantagem', cls: 'bg-cyan-900 border-cyan-600 hover:bg-cyan-800' },\n  { id: 'FOUL', label: 'Falta', cls: 'bg-amber-900/70 border-amber-600 hover:bg-amber-800' },\n  { id: 'FOUL_YELLOW', label: '\ud83d\udfe8 Falta + Amarelo', cls: 'bg-yellow-600 text-black border-yellow-400 hover:bg-yellow-500' },\n  { id: 'FOUL_RED', label: '\ud83d\udfe5 Falta + Vermelho', cls: 'bg-red-700 border-red-500 hover:bg-red-600' }\n];\n\nconst QuickCallPanel = ({ call, seconds, onAnswer }: { call: QuickCall; seconds: number; onAnswer: (c: QuickChoice | 'TIMEOUT') => void }) => {\n  const [left, setLeft] = useState(seconds);\n  useEffect(() => {\n    const t = setInterval(() => setLeft(v => Math.max(0, v - 0.1)), 100);\n    return () => clearInterval(t);\n  }, []);\n  useEffect(() => { if (left <= 0.05) onAnswer('TIMEOUT'); }, [left, onAnswer]);\n  return (\n    <div className=\"bg-slate-950 border-2 border-cyan-500/80 p-4 rounded-xl flex flex-col gap-3 shadow-2xl\">\n      <div className=\"flex items-center justify-between\">\n        <span className=\"text-xs font-black text-cyan-300\">\u26a1 LANCE R\u00c1PIDO \u2022 {call.minute}' \u2014 decida agora!</span>\n        <span className=\"text-xs font-mono text-amber-300\">{left.toFixed(1)}s</span>\n      </div>\n      <div className=\"h-1.5 bg-slate-800 rounded-full overflow-hidden\">\n        <div className=\"h-full bg-cyan-400 transition-all duration-100\" style={{ width: (left / seconds) * 100 + '%' }} />\n      </div>\n      <p className=\"text-xs text-slate-200 leading-relaxed\">{call.text}</p>\n      <div className=\"flex flex-wrap gap-2\">\n        {CALL_OPTIONS.map(o => (\n          <button key={o.id} onClick={() => onAnswer(o.id)} className={'px-3 py-2 rounded-lg text-xs font-bold border transition ' + o.cls}>{o.label}</button>\n        ))}\n      </div>\n    </div>\n  );\n};\n\nconst RIVALS: [string, number][] = [['Anderson Vidal', 9.12], ['Luciana Prado', 8.94], ['Marcos Teixeira', 8.71], ['Rog\u00e9rio Faria', 8.55], ['D\u00e9bora Nunes', 8.32], ['Eduardo Brand\u00e3o', 8.1], ['Tiago Moura', 7.85]];\n\nconst RankingPanel = ({ name, avg }: { name: string; avg: number }) => {\n  const list = [...RIVALS, [name, avg] as [string, number]].sort((a, b) => b[1] - a[1]);\n  return (\n    <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5\">\n      <h2 className=\"text-sm font-bold uppercase mb-3\">\ud83c\udfc5 Ranking de \u00e1rbitros</h2>\n      {list.map(([n, v], i) => (\n        <div key={n} className={'flex justify-between text-xs py-1.5 border-b border-slate-800/80 ' + (n === name ? 'text-emerald-300 font-bold' : '')}>\n          <span><span className=\"w-5 inline-block text-slate-500 font-mono\">{i + 1}</span>{n}</span>\n          <span className=\"font-mono\">{v.toFixed(2)}</span>\n        </div>\n      ))}\n    </div>\n  );\n};\n\nconst ShopPanel = ({ money, owned, onBuy }: { money: number; owned: string[]; onBuy: (id: string) => void }) => (\n  <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 flex flex-col gap-2\">\n    <h2 className=\"text-sm font-bold uppercase\">\ud83d\uded2 Loja de equipamentos</h2>\n    {EQUIPMENT.map(e => {\n      const has = owned.includes(e.id);\n      return (\n        <div key={e.id} className=\"flex items-center justify-between gap-2 text-xs bg-slate-950 border border-slate-800 rounded-xl p-2.5\">\n          <div><strong className=\"block\">{e.name}</strong><span className=\"text-[10px] text-slate-500\">{e.desc}</span></div>\n          <button disabled={has || money < e.price} onClick={() => onBuy(e.id)}\n            className=\"px-2.5 py-1.5 rounded-lg font-bold bg-emerald-700 hover:bg-emerald-600 disabled:bg-slate-800 disabled:text-slate-500 whitespace-nowrap transition\">\n            {has ? 'Comprado \u2713' : 'R$ ' + e.price.toLocaleString()}\n          </button>\n        </div>\n      );\n    })}\n  </div>\n);\n\nexport function App() {\n  const [showHistory, setShowHistory] = useState(false);\n  const {\n    isProfileCreated, season, seasonGame, equipment, quickCall, actionPoints, referee, teams, matchHistory, nextMatchSchedule, careerNews,\n    currentManagerIncident, currentGoalAnimation, gameTwistUsed, isEvaluatingPostMatch,\n    homeManagerEjected, awayManagerEjected, liveStats, activeMatch,\n    createProfile, startScheduledMatch, startSecondHalf, triggerGameTwistAction, clearGoalAnimation,\n    updateMatchMinute, setMatchSpeed, triggerInstantFieldDecision, openVarRadioIntercom, openVarMonitorOFR,\n    confirmFinalDecision, resolveManagerIncident, finishMatch, spendActionPoint, registerSprayUse,\n    drawNextSchedule, resetCareer, answerQuickCall, buyEquipment\n  } = useGameStore();\n\n  // Rel\u00f3gio da partida\n  const status = activeMatch?.status;\n  const speed = activeMatch?.matchSpeed ?? 1;\n  useEffect(() => {\n    if (status !== 'PLAYING' || currentManagerIncident || currentGoalAnimation) return;\n    const timer = setInterval(updateMatchMinute, Math.max(120, 700 / speed));\n    return () => clearInterval(timer);\n  }, [status, speed, currentManagerIncident, currentGoalAnimation, updateMatchMinute]);\n\n  // Carreira restaurada sem jogo agendado\n  useEffect(() => {\n    if (isProfileCreated && !nextMatchSchedule && !activeMatch) void drawNextSchedule();\n  }, [isProfileCreated, nextMatchSchedule, activeMatch, drawNextSchedule]);\n\n  const standings = teams.filter(t => t.tier === referee.tier).sort((a, b) => b.points - a.points || (b.goalsFor - b.goalsAgainst) - (a.goalsFor - a.goalsAgainst));\n  const sc = nextMatchSchedule;\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans\">\n      {!isProfileCreated && <ProfileModal onSave={createProfile} />}\n      {showHistory && <MatchHistoryModal history={matchHistory} onClose={() => setShowHistory(false)} />}\n      {currentGoalAnimation && <GoalCelebrationOverlay data={currentGoalAnimation} onClose={clearGoalAnimation} />}\n      {currentManagerIncident && <ManagerIncidentModal incident={currentManagerIncident} onResolve={resolveManagerIncident} />}\n\n      <header className=\"bg-slate-900/90 backdrop-blur border-b border-slate-800 px-6 py-3 flex flex-wrap items-center justify-between gap-4 sticky top-0 z-30\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"bg-gradient-to-br from-emerald-500 to-emerald-700 p-2 rounded-xl text-base leading-none shadow-lg shadow-emerald-900/40\">\u26bd</div>\n          <div>\n            <h1 className=\"text-base font-extrabold tracking-tight\">O APITO <span className=\"text-slate-500 font-semibold\">\u2022 Simulador de Arbitragem</span></h1>\n            <div className=\"flex items-center gap-2 text-xs text-slate-400\">\n              <span>{referee.federation}</span><span>\u2022</span>\n              <span className=\"text-emerald-400 font-bold\">{referee.tier.replace('_', ' ')}</span><span>\u2022</span>\n              <span>Temporada {season} \u2022 Jogo {seasonGame}/6</span>\n            </div>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-5 text-xs\">\n          <div><span className=\"text-slate-400 block\">\u00c1rbitro</span><span className=\"font-bold\">{referee.name}</span></div>\n          <div><span className=\"text-slate-400 block\">Nota UEFA</span><span className=\"font-bold text-emerald-400\">{referee.uefaAverageScore.toFixed(2)}</span></div>\n          <div><span className=\"text-slate-400 block\">Reputa\u00e7\u00e3o</span><span className=\"font-bold text-cyan-400\">{referee.reputation}</span></div>\n          <div><span className=\"text-slate-400 block\">Saldo</span><span className=\"font-bold text-amber-400\">R$ {referee.bankBalance.toLocaleString()}</span></div>\n          <button onClick={() => setShowHistory(true)} className=\"px-3 py-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg font-bold border border-slate-700 transition\">\ud83d\udcdc Hist\u00f3rico</button>\n          <button\n            onClick={() => { if (window.confirm('Apagar a carreira e come\u00e7ar do zero?')) resetCareer(); }}\n            className=\"px-3 py-1.5 bg-slate-900 hover:bg-red-950 text-slate-400 hover:text-red-300 rounded-lg border border-slate-800 transition\"\n          >Nova carreira</button>\n        </div>\n      </header>\n\n      <main className=\"flex-1 max-w-7xl w-full mx-auto p-6 grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <div className=\"lg:col-span-2 flex flex-col gap-5\">\n          {careerNews.length > 0 && !activeMatch && (\n            <div className=\"bg-amber-950/60 border border-amber-700/70 text-amber-200 rounded-xl p-3 text-xs font-bold\">\ud83d\udce3 {careerNews[0]}</div>\n          )}\n\n          {activeMatch ? (\n            <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 flex flex-col gap-4 shadow-xl\">\n              <div className=\"flex items-center justify-between bg-slate-950 p-4 rounded-xl border border-slate-800\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"w-3 h-3 rounded-full border border-white/50\" style={{ backgroundColor: activeMatch.homeTeam.primaryColor }} />\n                  <span className=\"font-black text-sm\">{activeMatch.homeTeam.name}</span>\n                </div>\n                <div className=\"text-center\">\n                  <span className=\"text-3xl font-black font-mono\">{activeMatch.homeScore} - {activeMatch.awayScore}</span>\n                  <span className=\"block text-[11px] text-emerald-400 font-mono font-bold\">\n                    {activeMatch.status === 'HALF_TIME' ? 'INTERVALO' : activeMatch.status === 'FINISHED' ? 'FIM DE JOGO' : activeMatch.minute + \"' \u2022 \" + activeMatch.half + '\u00ba TEMPO'}\n                  </span>\n                </div>\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"font-black text-sm\">{activeMatch.awayTeam.name}</span>\n                  <span className=\"w-3 h-3 rounded-full border border-white/50\" style={{ backgroundColor: activeMatch.awayTeam.primaryColor }} />\n                </div>\n              </div>\n\n              <div className=\"flex flex-wrap items-center justify-between gap-2 text-xs\">\n                <div className=\"flex items-center gap-1.5\">\n                  <span className=\"text-slate-400\">Velocidade:</span>\n                  {[1, 2, 4, 8].map(v => (\n                    <button key={v} onClick={() => setMatchSpeed(v)}\n                      className={'px-2.5 py-1 rounded-lg font-bold border transition ' + (activeMatch.matchSpeed === v ? 'bg-emerald-600 border-emerald-400 text-white' : 'bg-slate-800 border-slate-700 text-slate-300 hover:bg-slate-700')}>\n                      {v}x\n                    </button>\n                  ))}\n                </div>\n                <div className=\"flex flex-wrap items-center gap-1.5\">\n                  <span className=\"text-slate-400\">Reviravolta:</span>\n                  {TWISTS.map(t => (\n                    <button key={t} disabled={gameTwistUsed || activeMatch.status !== 'PLAYING'} onClick={() => triggerGameTwistAction(t)}\n                      className=\"px-2 py-1 rounded-lg bg-slate-800 border border-slate-700 text-[10px] font-bold text-slate-300 hover:bg-slate-700 disabled:opacity-35 transition\">\n                      {t}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <PitchCanvas\n                isPlaying={activeMatch.status === 'PLAYING'}\n                isPausedForKmi={activeMatch.status !== 'PLAYING'}\n                temperature={activeMatch.matchTemperature}\n                homeColor={activeMatch.homeTeam.primaryColor}\n                awayColor={activeMatch.awayTeam.primaryColor}\n                homeRedCards={activeMatch.homeRedCards}\n                awayRedCards={activeMatch.awayRedCards}\n                speed={activeMatch.matchSpeed}\n              />\n\n              {activeMatch.status === 'HALF_TIME' && (\n                <div className=\"bg-slate-950 border border-emerald-600/70 p-5 rounded-xl flex items-center justify-between gap-4\">\n                  <div>\n                    <span className=\"text-xs font-black text-emerald-400\">\u2615 INTERVALO</span>\n                    <p className=\"text-xs text-slate-300 mt-1\">Respire fundo. Os vesti\u00e1rios est\u00e3o agitados e o segundo tempo promete.</p>\n                  </div>\n                  <button onClick={startSecondHalf} className=\"px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 font-bold rounded-xl text-xs shadow-lg shadow-emerald-600/30 transition\">\u25b6\ufe0f Iniciar 2\u00ba Tempo</button>\n                </div>\n              )}\n\n              {quickCall && activeMatch.status === 'PLAYING' && (\n                <QuickCallPanel key={quickCall.id} call={quickCall} seconds={equipment.includes('COMMS') ? 9 : 6} onAnswer={answerQuickCall} />\n              )}\n\n              {activeMatch.status === 'KMI_PAUSED' && activeMatch.currentIncident && (\n                <div className=\"bg-slate-950 border border-amber-500/80 p-5 rounded-xl flex flex-col gap-3 shadow-2xl\">\n                  <span className=\"text-xs font-black text-amber-400\">\u26a0\ufe0f LANCE CAPITAL ({activeMatch.currentIncident.minute}')</span>\n                  <p className=\"text-xs text-slate-200 leading-relaxed\">{activeMatch.currentIncident.description}</p>\n                  <div className=\"flex flex-wrap gap-2\">\n                    <button onClick={openVarRadioIntercom} className=\"px-3.5 py-2 bg-indigo-600 hover:bg-indigo-500 rounded-lg text-xs font-bold transition\">\ud83d\udcfb R\u00e1dio VAR</button>\n                    <button onClick={openVarMonitorOFR} className=\"px-3.5 py-2 bg-red-600 hover:bg-red-500 rounded-lg text-xs font-bold transition\">\ud83d\udda5\ufe0f Ir ao Monitor (OFR)</button>\n                    <button onClick={() => triggerInstantFieldDecision('PLAY_ON')} className=\"px-3.5 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-lg text-xs font-bold transition\">Mandar seguir</button>\n                  </div>\n                </div>\n              )}\n\n              <div className=\"bg-slate-950 border border-slate-800 rounded-xl p-3 max-h-40 overflow-y-auto font-mono text-[11px] flex flex-col gap-1\">\n                {activeMatch.ticker.map((t, i) => (\n                  <div key={i} className={i === 0 ? 'text-amber-300 font-bold' : 'text-slate-400'}>{t}</div>\n                ))}\n              </div>\n            </div>\n          ) : (\n            <div className=\"flex flex-col gap-5\">\n              {sc && (\n                <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 flex flex-col gap-4 shadow-xl\">\n                  <div className=\"flex items-center justify-between gap-4\">\n                    <div>\n                      <span className=\"text-[10px] font-black tracking-wider uppercase text-amber-400\">Pr\u00f3xima escala\u00e7\u00e3o \u2022 Risco {sc.derbyRisk}</span>\n                      <h3 className=\"text-xl font-black text-white\">{sc.home.name} x {sc.away.name}</h3>\n                      <p className=\"text-xs text-slate-400\">{sc.stadium} \u2022 P\u00fablico previsto: {sc.attendance.toLocaleString()}</p>\n                    </div>\n                    <button onClick={startScheduledMatch} className=\"px-6 py-3 bg-emerald-600 hover:bg-emerald-500 font-bold rounded-xl shadow-lg shadow-emerald-600/30 transition whitespace-nowrap\">\u25b6\ufe0f Entrar em Campo</button>\n                  </div>\n                  <div className=\"bg-slate-950 rounded-xl border border-slate-800 p-4 text-xs flex flex-col gap-2\">\n                    <strong className=\"text-sm text-white italic\">\"{sc.storyline.pressHeadline}\"</strong>\n               