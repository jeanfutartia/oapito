import { useEffect, useState } from 'react';
import type { Incident, Team } from '../types/types';
import { PlayerFigure } from './PlayerFigure';

interface Props {
  incident: Incident;
  homeTeam: Team;
  awayTeam: Team;
}

type OffAngle = 'LINES' | 'BROADCAST' | 'BODY' | 'KICK';

const OFF_ANGLES: { id: OffAngle; label: string; cam: string }[] = [
  { id: 'LINES', label: 'Linhas (Aérea)', cam: 'CAM 01 • SKYCAM SEMI-AUTOMÁTICA' },
  { id: 'BROADCAST', label: 'Broadcast 3D', cam: 'CAM 02 • TV VIRTUAL 3D' },
  { id: 'BODY', label: 'Pontos do Corpo', cam: 'CAM 03 • TRACKING DE MEMBROS' },
  { id: 'KICK', label: 'Ponto do Passe', cam: 'CAM 04 • LATERAL 1000 FPS' }
];

const DEF_X = 84;
const gx = (x: number) => (x - 58) * 16;
const gy = (y: number) => 165 + (y - 34) * 16;
const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

const pb = (x: number, y: number) => {
  const u = (x - 58) / 46;
  const v = (y - 23.7) / 20.6;
  const taper = 0.78 + 0.22 * v;
  return { sx: 370 + (u - 0.5) * 740 * taper, sy: 55 + v * 240, k: 0.8 + 0.45 * v };
};

export const OffsideAnalysis = ({ incident, homeTeam, awayTeam }: Props) => {
  const o = incident.offside;
  const [angle, setAngle] = useState<OffAngle>('LINES');
  const [frame, setFrame] = useState(() => Math.max(0, (incident.offside?.kickFrame ?? 50) - 16));
  const [locked, setLocked] = useState(false);
  const [playing, setPlaying] = useState(false);
  const [speed, setSpeed] = useState(0.5);

  useEffect(() => {
    if (!playing) return;
    const id = setInterval(() => setFrame(f => Math.min(100, f + speed * 2)), 40);
    return () => clearInterval(id);
  }, [playing, speed]);

  useEffect(() => {
    if (playing && frame >= 100) setPlaying(false);
  }, [playing, frame]);

  if (!o) return null;

  const attTeam = incident.attackingTeam === 'HOME' ? homeTeam : awayTeam;
  const defTeam = incident.attackingTeam === 'HOME' ? awayTeam : homeTeam;
  const attColor = attTeam.primaryColor;
  const defColor = defTeam.primaryColor;

  const f = Math.round(frame);
  const delta = o.deltaCmAtKick + (f - o.kickFrame) * o.closingCmPerFrame;
  const isOffside = delta > 0;
  const diff = f - o.kickFrame;
  const ballLeft = diff >= 0;
  const tb = ballLeft ? diff / (100 - o.kickFrame) : 0;
  const ballX = 62.4 + (97 - 62.4) * tb;
  const ballY = 38.2 + (31 - 38.2) * tb;
  const attX = DEF_X + delta / 100;
  const phase = f * 0.35;
  const cam = OFF_ANGLES.find(a => a.id === angle)?.cam ?? '';
  const deltaTxt = `${delta > 0 ? '+' : ''}${delta.toFixed(1)} cm`;

  const kickState =
    diff < 0
      ? { t: `Bola no pé (faltam ${-diff} fr)`, c: 'text-emerald-300' }
      : diff === 0
        ? { t: '⚡ FRAME DO TOQUE', c: 'text-amber-300' }
        : { t: `Bola solta (+${diff} fr)`, c: 'text-red-300' };

  const dot = (key: string, x: number, y: number, color: string, num: number) => (
    <g key={key}>
      <circle cx={gx(x)} cy={gy(y)} r={8} fill={color} stroke="#fff" strokeWidth={1.5} />
      <text x={gx(x)} y={gy(y) + 3.5} textAnchor="middle" fontSize={9} fontWeight={800} fill="#fff">{num}</text>
    </g>
  );

  const stripeRects = Array.from({ length: 9 }, (_, i) => (
    <rect key={i} x={i * 88} y={0} width={88} height={330} fill={i % 2 === 0 ? '#0b3a1e' : '#0e4724'} />
  ));

  const renderLines = () => {
    const lupaOff = clamp(delta * 3, -90, 90);
    return (
      <svg viewBox="0 0 740 330" className="w-full h-[330px]">
        {stripeRects}
        <line x1={gx(88.5)} y1={0} x2={gx(88.5)} y2={330} stroke="rgba(255,255,255,0.6)" strokeWidth={2} />
        <line x1={gx(99.5)} y1={0} x2={gx(99.5)} y2={330} stroke="rgba(255,255,255,0.6)" strokeWidth={2} />
        {locked && (
          <g>
            <polygon points={`${gx(DEF_X)},0 ${gx(attX)},0 ${gx(attX)},330 ${gx(DEF_X)},330`} fill={isOffside ? 'rgba(239,68,68,0.35)' : 'rgba(34,197,94,0.3)'} />
            <line x1={gx(DEF_X)} y1={0} x2={gx(DEF_X)} y2={330} stroke="#38bdf8" strokeWidth={2.5} />
            <line x1={gx(attX)} y1={0} x2={gx(attX)} y2={330} stroke="#ef4444" strokeWidth={2.5} strokeDasharray="6 3" />
            <text x={gx(DEF_X) - 6} y={322} textAnchor="end" fontSize={10} fontWeight={700} fill="#38bdf8">LINHA DEFENSOR</text>
            <text x={gx(DEF_X) + 6} y={14} fontSize={10} fontWeight={700} fill="#fca5a5">LINHA ATACANTE</text>
          </g>
        )}
        {ballLeft && <line x1={gx(62.4)} y1={gy(38.2)} x2={gx(ballX)} y2={gy(ballY)} stroke="rgba(250,204,21,0.7)" strokeWidth={2} strokeDasharray="4 4" />}
        {dot('passer', 62, 38, attColor, o.passerNumber)}
        {dot('o1', 80, 25, defColor, 2)}
        {dot('o2', 81.5, 42, defColor, 5)}
        {dot('o3', 77, 35, defColor, 6)}
        {dot('a11', 79, 44, attColor, 11)}
        {dot('def', DEF_X - 0.4, 29, defColor, o.defenderNumber)}
        {dot('att', attX - 0.4, 31.5, attColor, o.attackerNumber)}
        {dot('gk', 103.5, 34, '#16a34a', 1)}
        <circle cx={gx(ballX)} cy={gy(ballY)} r={4.5} fill="#fff" stroke="#111" strokeWidth={1.5} />
        {Math.abs(diff) <= 1 && <circle cx={gx(ballX)} cy={gy(ballY)} r={14} fill="none" stroke="#facc15" strokeWidth={2} strokeDasharray="3 3" />}

        <g transform="translate(515 8)">
          <rect width={218} height={128} rx={8} fill="rgba(2,6,23,0.95)" stroke="#38bdf8" strokeWidth={1.5} />
          <text x={10} y={16} fontSize={10} fontWeight={800} fill="#38bdf8">LUPA 8x • PONTO DO PASSE</text>
          {locked ? (
            <g>
              <line x1={109} y1={26} x2={109} y2={104} stroke="#38bdf8" strokeWidth={2} />
              <line x1={109 + lupaOff} y1={26} x2={109 + lupaOff} y2={104} stroke="#ef4444" strokeWidth={2} strokeDasharray="4 2" />
              <ellipse cx={109 - 16} cy={88} rx={16} ry={6} fill={defColor} stroke="#fff" />
              <ellipse cx={109 + lupaOff - 16} cy={52} rx={16} ry={6} fill={attColor} stroke="#fff" />
              <text x={10} y={120} fontSize={11} fontWeight={800} fill={isOffside ? '#f87171' : '#4ade80'}>Δ {deltaTxt}</text>
              <text x={208} y={120} textAnchor="end" fontSize={9} fill="#94a3b8">{isOffside ? 'IMPEDIDO' : 'REGULAR'}</text>
            </g>
          ) : (
            <text x={109} y={70} textAnchor="middle" fontSize={10} fill="#94a3b8">Trace as linhas para medir</text>
          )}
        </g>
      </svg>
    );
  };

  const renderBroadcast = () => {
    const stripes = Array.from({ length: 9 }, (_, i) => {
      const x0 = 58 + i * 5.5;
      const pts = [
        [x0, 23.7],
        [x0 + 5.5, 23.7],
        [x0 + 5.5, 44.3],
        [x0, 44.3]
      ]
        .map(([x, y]) => `${pb(x, y).sx},${pb(x, y).sy}`)
        .join(' ');
      return <polygon key={i} points={pts} fill={i % 2 === 0 ? '#14532d' : '#1a6a35'} />;
    });
    const quad = (xa: number, xb: number) =>
      [
        [xa, 23.7],
        [xb, 23.7],
        [xb, 44.3],
        [xa, 44.3]
      ]
        .map(([x, y]) => `${pb(x, y).sx},${pb(x, y).sy}`)
        .join(' ');
    const actors = [
      { id: 'passer', x: 62, y: 38, n: o.passerNumber, c: attColor, dir: 1 as const },
      { id: 'o1', x: 80, y: 25, n: 2, c: defColor, dir: -1 as const },
      { id: 'o2', x: 81.5, y: 42, n: 5, c: defColor, dir: -1 as const },
      { id: 'def', x: DEF_X - 0.4, y: 29, n: o.defenderNumber, c: defColor, dir: -1 as const },
      { id: 'att', x: attX - 0.4, y: 31.5, n: o.attackerNumber, c: attColor, dir: 1 as const }
    ]
      .map(a => ({ ...a, ...pb(a.x, a.y) }))
      .sort((a, b) => a.sy - b.sy);
    const dl = pb(DEF_X, 23.7);
    const dl2 = pb(DEF_X, 44.3);
    const al = pb(attX, 23.7);
    const al2 = pb(attX, 44.3);
    const bp = pb(ballX, ballY);
    return (
      <svg viewBox="0 0 740 330" className="w-full h-[330px]">
        <rect width={740} height={330} fill="#0b1220" />
        {stripes}
        {locked && <polygon points={quad(DEF_X, attX)} fill={isOffside ? 'rgba(239,68,68,0.4)' : 'rgba(34,197,94,0.35)'} />}
        {locked && (
          <g>
            <line x1={dl.sx} y1={dl.sy} x2={dl2.sx} y2={dl2.sy} stroke="#38bdf8" strokeWidth={3} />
            <line x1={al.sx} y1={al.sy} x2={al2.sx} y2={al2.sy} stroke="#ef4444" strokeWidth={3} strokeDasharray="6 3" />
          </g>
        )}
        {actors.map(a => (
          <PlayerFigure key={a.id} sx={a.sx} sy={a.sy} h={78 * a.k} color={a.c} number={a.n} dir={a.dir} phase={phase + a.n} highlight={locked && (a.id === 'att' || a.id === 'def')} />
        ))}
        <circle cx={bp.sx} cy={bp.sy - 8} r={5} fill="#fff" stroke="#111" strokeWidth={1.5} />
        {locked && (
          <g transform="translate(250 6)">
            <rect width={240} height={34} rx={6} fill="rgba(2,6,23,0.92)" stroke={isOffside ? '#ef4444' : '#22c55e'} strokeWidth={2} />
            <text x={120} y={22} textAnchor="middle" fontSize={15} fontWeight={900} fill={isOffside ? '#f87171' : '#4ade80'}>
              {isOffside ? 'IMPEDIMENTO' : 'POSIÇÃO REGULAR'} • {deltaTxt}
            </text>
          </g>
        )}
      </svg>
    );
  };

  const renderBody = () => {
    const pxCm = 200 / Math.max(40, Math.abs(delta) + 30);
    const x0 = 340;
    const xa = clamp(x0 + delta * pxCm, 80, 700);
    const bestAtt = Math.max(...o.attackerParts.filter(p => p.legal).map(p => p.offsetCm));
    return (
      <svg viewBox="0 0 740 330" className="w-full h-[330px]">
        <rect width={740} height={330} fill="#0f172a" />
        <PlayerFigure sx={48} sy={140} h={100} color={defColor} number={o.defenderNumber} />
        <PlayerFigure sx={48} sy={262} h={100} color={attColor} number={o.attackerNumber} />
        <text x={90} y={30} fontSize={11} fontWeight={800} fill="#38bdf8">DEFENSOR #{o.defenderNumber} — último ponto jogável</text>
        <text x={90} y={170} fontSize={11} fontWeight={800} fill="#fca5a5">ATACANTE #{o.attackerNumber} — ponto mais avançado legal</text>
        <line x1={x0} y1={20} x2={x0} y2={290} stroke="#38bdf8" strokeWidth={2.5} />
        <line x1={xa} y1={20} x2={xa} y2={290} stroke="#ef4444" strokeWidth={2.5} strokeDasharray="6 3" />
        {o.defenderParts.map((p, i) => {
          const x = x0 + p.offsetCm * pxCm;
          return (
            <g key={p.name}>
              <circle cx={x} cy={95} r={7} fill="#38bdf8" stroke="#fff" strokeWidth={1.5} />
              <text x={x} y={i % 2 === 0 ? 78 : 119} textAnchor="middle" fontSize={9} fill="#bae6fd">{p.name}</text>
            </g>
          );
        })}
        {o.attackerParts.map((p, i) => {
          const x = xa + (p.offsetCm - bestAtt) * pxCm;
          const best = p.legal && p.offsetCm === bestAtt;
          return (
            <g key={p.name}>
              <circle cx={x} cy={215} r={best ? 9 : 7} fill={p.legal ? (best ? '#ef4444' : '#f97316') : '#475569'} stroke="#fff" strokeWidth={1.5} />
              <text x={x} y={i % 2 === 0 ? 195 : 241} textAnchor="middle" fontSize={9} fill={p.legal ? '#fed7aa' : '#94a3b8'}>
                {p.name}{!p.legal ? ' (não conta)' : ''}
              </text>
            </g>
          );
        })}
        {locked && (
          <g>
            <line x1={x0} y1={308} x2={xa} y2={308} stroke={isOffside ? '#ef4444' : '#22c55e'} strokeWidth={4} />
            <text x={(x0 + xa) / 2} y={324} textAnchor="middle" fontSize={13} fontWeight={900} fill={isOffside ? '#f87171' : '#4ade80'}>Δ {deltaTxt}</text>
          </g>
        )}
      </svg>
    );
  };

  const renderKick = () => {
    const ksx = 230;
    const ksy = 300;
    const bX = ballLeft ? ksx + 70 + diff * 11 : ksx + 70;
    const bY = ballLeft ? ksy - 16 - Math.min(diff * 1.4, 40) : ksy - 16;
    return (
      <svg viewBox="0 0 740 330" className="w-full h-[330px]">
        <rect width={740} height={330} fill="#0a2e19" />
        <rect y={300} width={740} height={30} fill="#14532d" />
        <line x1={0} y1={300} x2={740} y2={300} stroke="rgba(255,255,255,0.6)" strokeWidth={2} />
        <PlayerFigure sx={ksx} sy={ksy} h={250} color={attColor} number={o.passerNumber} label="PASSADOR" phase={phase} />
        <circle cx={bX} cy={bY} r={14} fill="#fff" stroke="#111" strokeWidth={2} />
        {diff === 0 && <circle cx={bX} cy={bY} r={26} fill="none" stroke="#facc15" strokeWidth={3} strokeDasharray="5 4" className="animate-pulse" />}
        <text x={720} y={30} textAnchor="end" fontSize={14} fontWeight={900} fill={diff < 0 ? '#6ee7b7' : diff === 0 ? '#fcd34d' : '#fca5a5'}>
          {kickState.t}
        </text>
        <text x={720} y={50} textAnchor="end" fontSize={10} fill="#94a3b8">Ache o primeiro frame em que a bola deixa o pé</text>
      </svg>
    );
  };

  return (
    <div className="w-full bg-slate-950 rounded-2xl overflow-hidden border border-slate-700 shadow-2xl flex flex-col select-none font-mono">
      <div className="flex flex-wrap justify-between items-center text-xs bg-slate-950/90 p-2.5 border-b border-slate-800 gap-2">
        <div className="flex items-center gap-2">
          <span className="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse" />
          <span className="bg-red-600 text-white font-black px-2 py-0.5 rounded text-[10px] tracking-wider">{cam}</span>
          <span className="text-emerald-400 font-bold">Frame {f}</span>
        </div>
        <span className={`font-bold text-[11px] ${kickState.c}`}>{kickState.t}</span>
        <span className="text-[11px] text-slate-400">
          ATAQUE: <strong className="text-red-300">{attTeam.shortName}</strong> • DEFESA: <strong className="text-blue-300">{defTeam.shortName}</strong>
        </span>
      </div>

      {angle === 'LINES' && renderLines()}
      {angle === 'BROADCAST' && renderBroadcast()}
      {angle === 'BODY' && renderBody()}
      {angle === 'KICK' && renderKick()}

      <div className="bg-slate-900/95 border-t border-slate-800 p-3 flex flex-col gap-2 text-xs">
        <div className="flex flex-wrap gap-1.5">
          {OFF_ANGLES.map(a => (
            <button
              key={a.id}
              onClick={() => setAngle(a.id)}
              className={`px-2.5 py-1 rounded-lg text-[11px] font-bold border transition ${
                angle === a.id ? 'bg-sky-600 text-white border-sky-400' : 'bg-slate-800 text-slate-400 border-slate-700 hover:bg-slate-700'
              }`}
            >
              {a.label}
            </button>
          ))}
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <button onClick={() => { if (frame >= 100) setFrame(0); setPlaying(p => !p); }} className="px-3 py-1 bg-emerald-600 hover:bg-emerald-500 rounded font-bold">
            {playing ? '⏸' : '▶'}
          </button>
          <button onClick={() => { setPlaying(false); setFrame(v => Math.max(0, Math.round(v) - 1)); }} className="px-2 py-1 bg-slate-800 rounded font-bold border border-slate-700">◀ -1 fr</button>
          <button onClick={() => { setPlaying(false); setFrame(v => Math.min(100, Math.round(v) + 1)); }} className="px-2 py-1 bg-slate-800 rounded font-bold border border-slate-700">+1 fr ▶</button>
          {[0.25, 0.5, 1].map(s => (
            <button key={s} onClick={() => setSpeed(s)} className={`px-2 py-1 rounded font-bold border ${speed === s ? 'bg-amber-500 text-black border-amber-300' : 'bg-slate-800 text-slate-400 border-slate-700'}`}>
              {s}x
            </button>
          ))}
          <button onClick={() => { setPlaying(false); setFrame(o.kickFrame); }} className="px-2.5 py-1 bg-indigo-600 hover:bg-indigo-500 rounded font-bold">🎯 Sincronizar toque (auto)</button>
          <button
            onClick={() => setLocked(l => !l)}
            className={`px-3 py-1 rounded font-bold ${locked ? 'bg-emerald-700 text-white' : 'bg-amber-500 text-black'}`}
          >
            {locked ? '✓ Linhas traçadas (limpar)' : '📐 Traçar linhas'}
          </button>
        </div>

        <input
          type="range"
          min={0}
          max={100}
          value={f}
          onChange={e => { setPlaying(false); setFrame(Number(e.target.value)); }}
          className="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-sky-500"
        />

        {locked ? (
          <div className={`p-2.5 rounded-lg border text-[11px] font-bold ${isOffside ? 'bg-red-950/70 border-red-700 text-red-200' : 'bg-emerald-950/70 border-emerald-700 text-emerald-200'}`}>
            {isOffside ? `IMPEDIMENTO: atacante ${deltaTxt} à frente da linha.` : `POSIÇÃO REGULAR: atacante ${deltaTxt} em relação à linha.`}
            {diff !== 0 && (
              <span className="block text-amber-300 mt-1">
                ⚠ Frame {f} difere do toque detectado ({o.kickFrame}). O resultado muda a cada frame; confirme o ponto do passe.
              </span>
            )}
          </div>
        ) : (
          <div className="text-[11px] text-slate-400">
            1) Ache o frame do passe • 2) Trace as linhas • 3) Decida. Mão e braço não contam; ombro, joelho e pé contam.
          </div>
        )}
      </div>
    </div>
  );
};
</file>

<file path="src/components/PitchCanvas.tsx">
import { useEffect, useRef } from 'react';

interface PitchCanvasProps {
  isPlaying: boolean;
  isPausedForKmi: boolean;
  temperature?: number;
  homeColor?: string;
  awayColor?: string;
  homeRedCards?: number;
  awayRedCards?: number;
  speed?: number; // matchSpeed do store
}

type Role = 'GK' | 'DF' | 'MF' | 'FW';
interface P {
  team: 0 | 1;
  role: Role;
  num: number;
  hx: number; // posição tática (0..1 a partir do próprio gol)
  hy: number;
  x: number;
  y: number;
  vx: number;
  vy: number;
  active: boolean;
}
interface Ball {
  x: number;
  y: number;
  owner: P | null;
  target: { x: number; y: number; to: P | null; shot: boolean } | null;
  hold: number;
  lastTeam: 0 | 1;
}

const W = 840;
const H = 520;
const M = 28;
const PW = W - M * 2;
const PH = H - M * 2;
const MAX_SPEED: Record<Role, number> = { GK: 60, DF: 88, MF: 98, FW: 106 };
const FOLLOW: Record<Role, number> = { GK: 0.03, DF: 0.28, MF: 0.42, FW: 0.36 };

// 4-4-2: [papel, x, y]
const FORMATION: [Role, number, number][] = [
  ['GK', 0.04, 0.5],
  ['DF', 0.22, 0.12], ['DF', 0.2, 0.37], ['DF', 0.2, 0.63], ['DF', 0.22, 0.88],
  ['MF', 0.48, 0.14], ['MF', 0.44, 0.38], ['MF', 0.44, 0.62], ['MF', 0.48, 0.86],
  ['FW', 0.72, 0.36], ['FW', 0.72, 0.64]
];

const dist = (ax: number, ay: number, bx: number, by: number) => Math.hypot(ax - bx, ay - by);
const toX = (team: 0 | 1, nx: number) => (team === 0 ? M + nx * PW : W - M - nx * PW);
const dirOf = (team: 0 | 1) => (team === 0 ? 1 : -1);

function buildPlayers(): P[] {
  const list: P[] = [];
  ([0, 1] as const).forEach(team => {
    FORMATION.forEach(([role, nx, ny], i) => {
      const x = toX(team, nx);
      const y = M + ny * PH;
      list.push({ team, role, num: i + 1, hx: nx, hy: ny, x, y, vx: 0, vy: 0, active: true });
    });
  });
  return list;
}

function kickoff(ball: Ball, players: P[], team: 0 | 1) {
  players.forEach(p => {
    p.x = toX(p.team, p.hx * 0.9);
    p.y = M + p.hy * PH;
    p.vx = p.vy = 0;
  });
  const starter = players.filter(p => p.team === team && p.role === 'FW' && p.active)[0];
  ball.owner = starter ?? null;
  ball.target = null;
  ball.hold = 0.8;
  ball.lastTeam = team;
  if (starter) {
    starter.x = W / 2 - dirOf(team) * 6;
    starter.y = H / 2;
  }
  ball.x = W / 2;
  ball.y = H / 2;
}

const SKINS = ['#f1c9a5', '#d9a273', '#a9724a', '#7a4b2e', '#f6d7bf'];
const HAIRS = ['#1b1b1b', '#3b2a1a', '#6b4a2b', '#c9a24d', '#111111'];
const CROWD = ['#ef4444', '#f8fafc', '#3b82f6', '#facc15', '#22c55e', '#94a3b8', '#f97316'];
const hsh = (n: number) => Math.abs(Math.sin(n * 127.1) * 43758.5453) % 1;
const light = (hex: string) => {
  const h = hex.replace('#', '');
  const f = h.length === 3 ? h.split('').map(c => c + c).join('') : h;
  const n = parseInt(f, 16);
  return (((n >> 16) & 255) * 0.299 + ((n >> 8) & 255) * 0.587 + (n & 255) * 0.114) > 150;
};

export const PitchCanvas = ({
  isPlaying,
  isPausedForKmi,
  homeColor = '#dc2626',
  awayColor = '#f8fafc',
  homeRedCards = 0,
  awayRedCards = 0,
  speed = 1
}: PitchCanvasProps) => {
  const canvasRef = useRef<HTMLCanvasElement | null>(null);
  const propsRef = useRef({ isPlaying, isPausedForKmi, homeColor, awayColor, homeRedCards, awayRedCards, speed });
  propsRef.current = { isPlaying, isPausedForKmi, homeColor, awayColor, homeRedCards, awayRedCards, speed };

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const players = buildPlayers();
    const ball: Ball = { x: W / 2, y: H / 2, owner: null, target: null, hold: 0, lastTeam: 0 };
    const ref = { x: W / 2 - 40, y: H / 2 + 40, vx: 0, vy: 0 };
    kickoff(ball, players, 0);

    let raf = 0;
    let last = performance.now();
    let clock = 0;

    const setActive = () => {
      const { homeRedCards: hr, awayRedCards: ar } = propsRef.current;
      ([0, 1] as const).forEach(team => {
        const outfield = players.filter(p => p.team === team && p.role !== 'GK');
        const reds = Math.min(team === 0 ? hr : ar, 4);
        outfield.forEach((p, i) => {
          p.active = i < outfield.length - reds;
        });
      });
    };

    const steer = (p: P, tx: number, ty: number, max: number, dt: number) => {
      const d = dist(p.x, p.y, tx, ty);
      const k = Math.min(1, d / 36);
      const dx = d > 0.001 ? ((tx - p.x) / d) * max * k : 0;
      const dy = d > 0.001 ? ((ty - p.y) / d) * max * k : 0;
      const a = Math.min(1, dt * 5);
      p.vx += (dx - p.vx) * a;
      p.vy += (dy - p.vy) * a;
    };

    const pickPass = (from: P): P | null => {
      const d = dirOf(from.team);
      let best: P | null = null;
      let bestScore = -1e9;
      players.forEach(q => {
        if (q === from || q.team !== from.team || !q.active) return;
        const dd = dist(from.x, from.y, q.x, q.y);
        if (dd < 50 || dd > 320) return;
        const progress = (q.x - from.x) * d;
        const nearestOpp = Math.min(
          ...players.filter(o => o.team !== from.team && o.active).map(o => dist(o.x, o.y, q.x, q.y))
        );
        const score = progress * 0.6 + nearestOpp * 0.9 - dd * 0.25 + Math.random() * 45;
        if (score > bestScore) {
          bestScore = score;
          best = q;
        }
      });
      return best;
    };

    const step = (dt: number) => {
      setActive();
      const poss: 0 | 1 = ball.owner ? ball.owner.team : ball.lastTeam;

      // Quem pressiona: os 2 marcadores de linha mais próximos da bola
      const chasers = new Set<P>();
      players
        .filter(p => p.active && p.role !== 'GK' && (p.team !== poss || !ball.owner))
        .sort((a, b) => dist(a.x, a.y, ball.x, ball.y) - dist(b.x, b.y, ball.x, ball.y))
        .slice(0, 2)
        .forEach(p => chasers.add(p));

      players.forEach(p => {
        if (!p.active) return;
        const d = dirOf(p.team);
        let tx: number;
        let ty: number;
        let max = MAX_SPEED[p.role];

        if (ball.owner === p) {
          // condutor: avança em direção ao gol, desviando de marcadores
          const goalX = p.team === 0 ? W - M : M;
          const threat = players
            .filter(o => o.team !== p.team && o.active && dist(o.x, o.y, p.x, p.y) < 55)
            .sort((a, b) => dist(a.x, a.y, p.x, p.y) - dist(b.x, b.y, p.x, p.y))[0];
          tx = p.x + d * 80;
          ty = p.y + (H / 2 - p.y) * 0.25 + (threat ? (p.y > threat.y ? 40 : -40) : 0);
          tx = Math.max(M, Math.min(W - M, tx));
          ty = Math.max(M + 10, Math.min(H - M - 10, ty));
          max *= 0.9;
          if (Math.abs(goalX - p.x) < 8) max = 0;
        } else if (ball.target?.to === p || chasers.has(p) || (ball.owner === null && !ball.target && p.role !== 'GK')) {
          tx = ball.target ? ball.target.x : ball.x;
          ty = ball.target ? ball.target.y : ball.y;
          if (chasers.has(p)) max *= 1.05;
        } else {
          // posição tática: bloco desliza com a bola; time com a posse sobe
          const push = p.team === poss ? d * 55 * (p.role === 'GK' ? 0 : 1) : -d * 15;
          const baseX = toX(p.team, p.hx);
          tx = baseX + (ball.x - baseX) * FOLLOW[p.role] + push;
          ty = M + p.hy * PH + (ball.y - (M + p.hy * PH)) * 0.22;
          if (p.role === 'GK') tx = toX(p.team, p.hx);
        }
        steer(p, tx, ty, max, dt);
      });

      // separação para ninguém se sobrepor
      for (let i = 0; i < players.length; i++) {
        const a = players[i];
        if (!a.active) continue;
        for (let j = i + 1; j < players.length; j++) {
          const b = players[j];
          if (!b.active) continue;
          const dd = dist(a.x, a.y, b.x, b.y);
          if (dd > 0 && dd < 18) {
            const push = (18 - dd) * 0.5;
            const nx = (a.x - b.x) / dd;
            const ny = (a.y - b.y) / dd;
            a.x += nx * push;
            a.y += ny * push;
            b.x -= nx * push;
            b.y -= ny * push;
          }
        }
      }
      players.forEach(p => {
        if (!p.active) return;
        p.x = Math.max(M - 6, Math.min(W - M + 6, p.x + p.vx * dt));
        p.y = Math.max(M - 6, Math.min(H - M + 6, p.y + p.vy * dt));
      });

      // bola
      if (ball.owner) {
        const o = ball.owner;
        const sp = Math.hypot(o.vx, o.vy) || 1;
        const bx = o.x + (o.vx / sp) * 11;
        const by = o.y + (o.vy / sp) * 11 + 2;
        ball.x += (bx - ball.x) * Math.min(1, dt * 14);
        ball.y += (by - ball.y) * Math.min(1, dt * 14);
        ball.lastTeam = o.team;
        ball.hold -= dt;

        // desarme
        const tackler = players.find(
          q => q.team !== o.team && q.active && dist(q.x, q.y, ball.x, ball.y) < 13
        );
        if (tackler && Math.random() < dt * 0.9) {
          ball.owner = tackler;
          ball.hold = 0.6 + Math.random() * 0.5;
          return;
        }

        if (ball.hold <= 0) {
          const goalX = o.team === 0 ? W - M : M;
          const nearGoal = Math.abs(goalX - o.x) < 190;
          if (nearGoal && o.role !== 'GK' && Math.random() < 0.55) {
            ball.target = { x: goalX, y: H / 2 + (Math.random() - 0.5) * 70, to: null, shot: true };
            ball.owner = null;
          } else {
            const q = pickPass(o);
            if (q) {
              ball.target = { x: q.x + q.vx * 0.5, y: q.y + q.vy * 0.5, to: q, shot: false };
              ball.owner = null;
            } else {
              ball.hold = 0.5;
            }
          }
        }
      } else if (ball.target) {
        const t = ball.target;
        if (t.to) {
          t.x = t.to.x + t.to.vx * 0.3;
          t.y = t.to.y + t.to.vy * 0.3;
        }
        const sp = t.shot ? 520 : 330;
        const d = dist(ball.x, ball.y, t.x, t.y);
        const mv = sp * dt;
        if (d <= mv) {
          ball.x = t.x;
          ball.y = t.y;
          if (t.shot) {
            const defTeam: 0 | 1 = ball.lastTeam === 0 ? 1 : 0;
            if (Math.random() < 0.25) {
              kickoff(ball, players, defTeam); // gol: recomeço
            } else {
              ball.owner = players.find(p => p.team === defTeam && p.role === 'GK') ?? null;
              ball.target = null;
              ball.hold = 1.2;
            }
          } else {
            ball.owner = t.to;
            ball.target = null;
            ball.hold = 0.5 + Math.random() * 0.9;
          }
        } else {
          ball.x += ((t.x - ball.x) / d) * mv;
          ball.y += ((t.y - ball.y) / d) * mv;
          // interceptação
          const thief = players.find(
            q => q.active && q.team !== ball.lastTeam && dist(q.x, q.y, ball.x, ball.y) < 11
          );
          if (thief && Math.random() < 0.06) {
            ball.owner = thief;
            ball.target = null;
            ball.hold = 0.5;
          }
        }
      }

      // árbitro: fica na diagonal, fora da linha de passe
      const side = ball.y < H / 2 ? 1 : -1;
      const rx = ball.x - dirOf(ball.owner?.team ?? ball.lastTeam) * 38;
      const ry = ball.y + side * 34;
      steer(ref as unknown as P, rx, Math.max(M, Math.min(H - M, ry)), 82, dt);
      ref.x += ref.vx * dt;
      ref.y += ref.vy * dt;
    };

    const drawPitch = () => {
      const stripes = 14;
      for (let i = 0; i < stripes; i++) {
        ctx.fillStyle = i % 2 === 0 ? '#1d6a2c' : '#217a33';
        ctx.fillRect((W / stripes) * i, 0, W / stripes + 1, H);
      }
      const vg = ctx.createRadialGradient(W / 2, H / 2, H * 0.3, W / 2, H / 2, W * 0.65);
      vg.addColorStop(0, 'rgba(0,0,0,0)');
      vg.addColorStop(1, 'rgba(0,0,0,0.38)');
      ctx.fillStyle = vg;
      ctx.fillRect(0, 0, W, H);

      // arquibancadas ao redor do gramado
      const bands: [number, number, number, number][] = [[0, 0, W, M - 6], [0, H - M + 6, W, M - 6], [0, 0, M - 6, H], [W - M + 6, 0, M - 6, H]];
      bands.forEach(([bx, by, bw, bh], k) => {
        ctx.fillStyle = '#0b1220';
        ctx.fillRect(bx, by, bw, bh);
        const n = Math.floor((bw * bh) / 34);
        for (let i = 0; i < n; i++) {
          ctx.fillStyle = CROWD[Math.floor(hsh(i * 1.3 + k) * CROWD.length)];
          ctx.fillRect(bx + hsh(i + k * 1000) * bw, by + hsh(i * 3.7 + k * 77) * bh, 2.2, 2.2);
        }
      });

      ctx.strokeStyle = 'rgba(255,255,255,0.85)';
      ctx.lineWidth = 2;
      ctx.strokeRect(M, M, PW, PH);
      ctx.beginPath();
      ctx.moveTo(W / 2, M);
      ctx.lineTo(W / 2, H - M);
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(W / 2, H / 2, 56, 0, Math.PI * 2);
      ctx.stroke();
      ctx.fillStyle = 'rgba(255,255,255,0.85)';
      ctx.beginPath();
      ctx.arc(W / 2, H / 2, 3, 0, Math.PI * 2);
      ctx.fill();

      ([0, 1] as const).forEach(team => {
        const s = team === 0 ? 1 : -1;
        const gx = team === 0 ? M : W - M;
        ctx.strokeRect(team === 0 ? gx : gx - 123, H / 2 - 150, 123, 300);
        ctx.strokeRect(team === 0 ? gx : gx - 41, H / 2 - 68, 41, 136);
        ctx.beginPath();
        ctx.arc(gx + s * 82, H / 2, 3, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(gx + s * 82, H / 2, 68, team === 0 ? -0.93 : Math.PI - 0.93, team === 0 ? 0.93 : Math.PI + 0.93);
        ctx.stroke();
        ctx.strokeStyle = 'rgba(255,255,255,0.5)';
        ctx.strokeRect(team === 0 ? gx - 14 : gx, H / 2 - 34, 14, 68);
        ctx.strokeStyle = 'rgba(255,255,255,0.85)';
      });
    };

    interface Fig {
      kit: string; shorts: string; socks: string; skin: string; hair: string; face: number; phase: number;
      moving: number; num?: number; numColor?: string; ring?: boolean;
    }
    // Jogador "em pé" com ciclo de corrida (pernas e braços balançam) e escala de perspectiva
    const drawFigure = (x: number, y: number, o: Fig) => {
      const s = 0.78 + (y / H) * 0.4;
      const sw = Math.sin(o.phase) * 6 * o.moving;
      const lift = Math.abs(Math.cos(o.phase)) * 1.4 * o.moving;
      const f = o.face;
      ctx.save();
      ctx.translate(x, y);
      ctx.scale(s, s);
      ctx.fillStyle = 'rgba(0,0,0,0.32)';
      ctx.beginPath();
      ctx.ellipse(0, 1, 10, 3.5, 0, 0, Math.PI * 2);
      ctx.fill();
      if (o.ring) {
        ctx.strokeStyle = '#facc15';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.ellipse(0, 1, 14, 5.5, 0, 0, Math.PI * 2);
        ctx.stroke();
      }
      ctx.lineCap = 'round';
      // pernas + chuteiras
      ctx.strokeStyle = o.socks;
      ctx.lineWidth = 3.2;
      ctx.beginPath(); ctx.moveTo(-2, -10); ctx.lineTo(-2 + sw * f, -1 - lift); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(2, -10); ctx.lineTo(2 - sw * f, -1); ctx.stroke();
      ctx.fillStyle = '#0b0f19';
      ctx.fillRect(-2 + sw * f - 2 + (f > 0 ? 1 : -1), -2.5 - lift, 4.5, 2.5);
      ctx.fillRect(2 - sw * f - 2 + (f > 0 ? 1 : -1), -2.5, 4.5, 2.5);
      // braços
      ctx.strokeStyle = o.skin;
      ctx.lineWidth = 2.4;
      ctx.beginPath(); ctx.moveTo(-5, -19.5); ctx.lineTo(-6 - sw * 0.5 * f, -12); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(5, -19.5); ctx.lineTo(6 + sw * 0.5 * f, -12); ctx.stroke();
      // calção e camisa
      ctx.fillStyle = o.shorts;
      ctx.fillRect(-4.8, -13, 9.6, 5);
      ctx.fillStyle = o.kit;
      ctx.fillRect(-5.2, -21, 10.4, 9);
      ctx.strokeStyle = 'rgba(15,23,42,0.7)';
      ctx.lineWidth = 0.9;
      ctx.strokeRect(-5.2, -21, 10.4, 9);
      if (o.num !== undefined) {
        ctx.fillStyle = o.numColor ?? '#fff';
        ctx.font = 'bold 6.5px system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(String(o.num), 0, -16);
      }
      // cabeça + cabelo
      ctx.fillStyle = o.skin;
      ctx.beginPath(); ctx.arc(0, -25, 4.2, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = o.hair;
      ctx.beginPath(); ctx.arc(0, -25.6, 4.4, Math.PI, 0); ctx.fill();
      ctx.restore();
    };

    const drawPlayer = (p: P, color: string, isOwner: boolean) => {
      const gk = p.role === 'GK';
      const kit = gk ? '#22d3ee' : color;
      const bright = light(kit);
      drawFigure(p.x, p.y, {
        kit,
        shorts: gk ? '#0f172a' : bright ? '#111827' : '#f8fafc',
        socks: gk ? '#0f172a' : kit,
        skin: SKINS[(p.num * 3 + p.team * 2) % SKINS.length],
        hair: HAIRS[(p.num + p.team * 3) % HAIRS.length],
        num: p.num,
        numColor: bright ? '#0f172a' : '#ffffff',
        face: Math.abs(p.vx) > 6 ? Math.sign(p.vx) : dirOf(p.team),
        phase: (p.x + p.y * 0.5) / 5.5,
        moving: Math.min(1, Math.hypot(p.vx, p.vy) / 70),
        ring: isOwner
      });
    };

    const render = (now: number) => {
      const pr = propsRef.current;
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      const running = pr.isPlaying && !pr.isPausedForKmi;
      if (running) {
        const sim = dt * Math.max(1, pr.speed);
        clock += sim;
        step(sim);
      }

      ctx.clearRect(0, 0, W, H);
      drawPitch();

      // linha de visão do árbitro
      ctx.strokeStyle = pr.isPausedForKmi ? 'rgba(239,68,68,0.9)' : 'rgba(250,204,21,0.28)';
      ctx.setLineDash([5, 5]);
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(ref.x, ref.y);
      ctx.lineTo(ball.x, ball.y);
      ctx.stroke();
      ctx.setLineDash([]);

      [...players]
        .filter(p => p.active)
        .sort((a, b) => a.y - b.y)
        .forEach(p => drawPlayer(p, p.team === 0 ? pr.homeColor : pr.awayColor, ball.owner === p));

      // árbitro (camisa amarela, calção preto)
      drawFigure(ref.x, ref.y, {
        kit: '#facc15', shorts: '#111827', socks: '#111827', skin: SKINS[1], hair: '#222222',
        face: ball.x >= ref.x ? 1 : -1, phase: (ref.x + ref.y * 0.5) / 5.5,
        moving: Math.min(1, Math.hypot(ref.vx, ref.vy) / 70)
      });

      // bola (com altura nos passes)
      const flying = !ball.owner && ball.target;
      const lift = flying ? Math.sin(clock * 14) * 0 + 4 : 0;
      ctx.fillStyle = 'rgba(0,0,0,0.35)';
      ctx.beginPath();
      ctx.ellipse(ball.x, ball.y + 4, 5, 2.2, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#fff';
      ctx.strokeStyle = '#111';
      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.arc(ball.x, ball.y - lift, 5, 0, Math.PI * 2);
      ctx.fill();
      ctx.stroke();

      // pausa para lance capital: anel pulsante
      if (pr.isPausedForKmi) {
        const pulse = 14 + Math.sin(now / 160) * 4;
        ctx.strokeStyle = 'rgba(239,68,68,0.9)';
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.arc(ball.x, ball.y, pulse, 0, Math.PI * 2);
        ctx.stroke();
      }

      raf = requestAnimationFrame(render);
    };

    raf = requestAnimationFrame(render);
    return () => cancelAnimationFrame(raf);
  }, []);

  return (
    <div className="relative w-full rounded-xl overflow-hidden border border-slate-700 shadow-2xl bg-black">
      <canvas ref={canvasRef} className="w-full h-auto block" style={{ aspectRatio: `${W} / ${H}` }} />
    </div>
  );
};
</file>

