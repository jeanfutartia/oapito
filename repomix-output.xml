const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
const fmtMin = (m: number) => (m > 90 ? `90+${m - 90}` : String(m));
let drawing = false;

function buildGoalAnim(
  a: ActiveMatch,
  side: 'HOME' | 'AWAY',
  minute: number,
  num: number,
  isPenalty: boolean,
  variant: 'GOAL' | 'DISALLOWED',
  reason?: string
): GoalAnimationData {
  const team = side === 'HOME' ? a.homeTeam : a.awayTeam;
  return {
    variant,
    reason,
    teamName: team.name,
    teamColor: team.primaryColor,
    minute,
    playerNumber: num,
    isPenalty,
    homeName: a.homeTeam.name,
    awayName: a.awayTeam.name,
    homeShort: a.homeTeam.shortName,
    awayShort: a.awayTeam.shortName,
    homeColor: a.homeTeam.primaryColor,
    awayColor: a.awayTeam.primaryColor,
    homeScore: a.homeScore,
    awayScore: a.awayScore,
    scoringSide: side
  };
}

function applyIncidentDecision(
  active: ActiveMatch,
  decision: DecisionType,
  viaVar: boolean
): { match: ActiveMatch; goalAnim: GoalAnimationData | null; foulSide: 'HOME' | 'AWAY' | null } {
  const inc = active.currentIncident as Incident;
  const m: ActiveMatch = {
    ...active,
    ticker: [...active.ticker],
    report: {
      ...active.report,
      goals: [...active.report.goals],
      cards: [...active.report.cards],
      varReviews: [...active.report.varReviews]
    }
  };
  const minute = inc.minute;
  const attSide = inc.attackingTeam;
  const offSide = inc.offendingTeam;
  let goalAnim: GoalAnimationData | null = null;
  let foulSide: 'HOME' | 'AWAY' | null = null;

  const scoreFor = (side: 'HOME' | 'AWAY', isPenalty: boolean, num: number) => {
    if (side === 'HOME') m.homeScore += 1;
    else m.awayScore += 1;
    m.report.goals.push({ minute, team: side, playerNumber: num, isPenalty });
    return buildGoalAnim(m, side, minute, num, isPenalty, 'GOAL');
  };
  const card = (type: 'YELLOW' | 'RED') => {
    m.report.cards.push({
      minute,
      team: offSide,
      targetType: 'PLAYER',
      targetLabel: `Camisa nº ${inc.offendingPlayerNumber}`,
      cardType: type,
      reason: inc.title
    });
    if (type === 'RED') {
      if (offSide === 'HOME') m.homeRedCards += 1;
      else m.awayRedCards += 1;
    }
    foulSide = offSide;
  };

  switch (decision) {
    case 'GOAL_VALID':
      if (inc.goalPending) {
        goalAnim = scoreFor(attSide, false, inc.offside?.attackerNumber ?? 9);
        m.ticker.unshift(`${fmtMin(minute)}' ⚽ GOL CONFIRMADO: ${DECISION_LABEL[decision]}.`);
      }
      break;
    case 'GOAL_DISALLOWED':
      if (inc.goalPending) {
        goalAnim = buildGoalAnim(m, attSide, minute, inc.offside?.attackerNumber ?? 9, false, 'DISALLOWED', inc.offside ? 'Impedimento detectado' : 'Falta no ataque');
        m.ticker.unshift(`${fmtMin(minute)}' 🚫 GOL ANULADO após revisão.`);
      }
      break;
    case 'YELLOW_CARD':
      card('YELLOW');
      m.ticker.unshift(`${fmtMin(minute)}' 🟨 Cartão amarelo para o nº ${inc.offendingPlayerNumber}.`);
      break;
    case 'RED_CARD':
      card('RED');
      m.ticker.unshift(`${fmtMin(minute)}' 🟥 EXPULSÃO do nº ${inc.offendingPlayerNumber}!`);
      break;
    case 'PENALTY':
    case 'PENALTY_YELLOW':
    case 'PENALTY_RED': {
      if (decision === 'PENALTY_YELLOW') card('YELLOW');
      if (decision === 'PENALTY_RED') card('RED');
      foulSide = offSide;
      m.ticker.unshift(`${fmtMin(minute)}' 🎯 PÊNALTI marcado!`);
      if (Math.random() < 0.75) {
        goalAnim = scoreFor(attSide, true, 10);
        m.ticker.unshift(`${fmtMin(minute)}' ⚽ Pênalti convertido!`);
      } else {
        m.ticker.unshift(`${fmtMin(minute)}' 🧤 Pênalti desperdiçado!`);
      }
      break;
    }
    case 'FOUL':
      foulSide = offSide;
      m.ticker.unshift(`${fmtMin(minute)}' Falta assinalada.`);
      break;
    default:
      m.ticker.unshift(`${fmtMin(minute)}' Jogo segue: ${DECISION_LABEL[decision]}.`);
  }

  const isCorrect = inc.acceptableDecisions.includes(decision);
  m.matchRating = clamp(m.matchRating + (isCorrect ? 0.12 : -0.45), 4, 10);
  m.decisionsHistory = [...m.decisionsHistory, { incident: inc, initial: inc.fieldDecision, final: decision, isCorrect }];
  if (viaVar) {
    m.report.varReviews.push({ minute, title: inc.title, decision, overturned: decision !== inc.fieldDecision });
  }
  m.status = 'PLAYING';
  m.currentIncident = null;
  return { match: m, goalAnim, foulSide };
}

function applyResult(teams: Team[], home: Team, away: Team, hs: number, aws: number): Team[] {
  return teams.map(t => {
    if (t.id !== home.id && t.id !== away.id) return t;
    const isHome = t.id === home.id;
    const gf = isHome ? hs : aws;
    const ga = isHome ? aws : hs;
    const won = gf > ga;
    const drawn = gf === ga;
    return {
      ...t,
      played: t.played + 1,
      won: t.won + (won ? 1 : 0),
      drawn: t.drawn + (drawn ? 1 : 0),
      lost: t.lost + (!won && !drawn ? 1 : 0),
      goalsFor: t.goalsFor + gf,
      goalsAgainst: t.goalsAgainst + ga,
      points: t.points + (won ? 3 : drawn ? 1 : 0)
    };
  });
}

interface GameState {
  isProfileCreated: boolean;
  geminiValidation: { tested: boolean; valid: boolean; message: string };
  week: number;
  referee: RefereeProfile;
  teams: Team[];
  resolvedIncidentIds: string[];
  matchHistory: MatchReport[];
  nextMatchSchedule: NextScheduleData | null;
  currentManagerIncident: ManagerIncident | null;
  currentGoalAnimation: GoalAnimationData | null;
  isEvaluatingPostMatch: boolean;
  postMatch: PostMatchData | null;
  homeManagerEjected: boolean;
  awayManagerEjected: boolean;
  liveStats: MatchLiveStats;
  activeMatch: ActiveMatch | null;

  createProfile: (profile: { name: string; age: number; federation: string; style: RefereeStyle; apiKey: string }) => Promise<void>;
  validateApiKey: (apiKey: string) => Promise<boolean>;
  drawNextSchedule: () => Promise<void>;
  startScheduledMatch: () => void;
  clearGoalAnimation: () => void;
  updateMatchMinute: () => void;
  setMatchSpeed: (speed: number) => void;
  openVarRadioIntercom: () => void;
  openVarMonitorOFR: () => void;
  resolveIncident: (decision: DecisionType, viaVar: boolean) => void;
  triggerInstantFieldDecision: (decision?: DecisionType) => Promise<void>;
  confirmFinalDecision: (decision: DecisionType) => Promise<void>;
  resolveManagerIncident: (action: 'VERBAL_WARNING' | 'YELLOW_CARD' | 'RED_CARD') => void;
  finalizeMatch: () => Promise<void>;
  finishMatch: () => Promise<void>;
  registerSprayUse: () => void;
  resetCareer: () => void;
}

export const useGameStore = create<GameState>()(
  persist(
    (set, get) => ({
      isProfileCreated: false,
      geminiValidation: { tested: false, valid: false, message: 'Não testado' },
      week: 1,
      referee: {
        name: 'Carlos Silva',
        age: 26,
        federation: 'Federação Paulista (FPF)',
        style: 'DIALOGADOR',
        tier: 'SERIE_D',
        reputation: 60,
        uefaAverageScore: 8.4,
        geminiApiKey: '',
        attributes: { physicalCondition: 72, stressResistance: 65, authority: 68, ruleKnowledge: 75, integrity: 95 },
        stats: { matches: 0, yellowCards: 0, redCards: 0, penalties: 0, varInterventions: 0 }
      },
      teams: ALL_TEAMS_DATABASE,
      resolvedIncidentIds: [],
      matchHistory: [],
      nextMatchSchedule: null,
      currentManagerIncident: null,
      currentGoalAnimation: null,
      isEvaluatingPostMatch: false,
      postMatch: null,
      homeManagerEjected: false,
      awayManagerEjected: false,
      liveStats: INITIAL_STATS,
      activeMatch: null,

      validateApiKey: async (apiKey: string) => {
        const res = await testGeminiApiKey(apiKey);
        set({ geminiValidation: { tested: true, valid: res.success, message: res.message } });
        return res.success;
      },

      createProfile: async ({ name, age, federation, style, apiKey }) => {
        let isValid = false;
        if (apiKey && apiKey.trim() !== '') {
          const res = await testGeminiApiKey(apiKey);
          isValid = res.success;
          set({ geminiValidation: { tested: true, valid: res.success, message: res.message } });
        }
        set(state => ({
          isProfileCreated: true,
          referee: {
            ...state.referee,
            name: name.trim() || 'Árbitro Oficial',
            age: age || 26,
            federation: federation.trim() || 'CBF',
            style,
            tier: 'SERIE_D',
            geminiApiKey: isValid ? apiKey.trim() : ''
          }
        }));
      },

      drawNextSchedule: async () => {
        if (drawing) return;
        drawing = true;
        try {
          const tier = get().referee.tier;
          const pool = get().teams.filter(t => t.tier === tier);
          const shuffled = [...pool].sort(() => Math.random() - 0.5);
          const home = shuffled[0] || ALL_TEAMS_DATABASE[0];
          const away = shuffled[1] || ALL_TEAMS_DATABASE[1];
          const storyline = await generatePreMatchStoryline(home, away, tier, get().referee.name, get().referee.geminiApiKey);
          set({
            nextMatchSchedule: {
              home,
              away,
              stadium: home.stadiumName,
              derbyRisk: (['BAIXO', 'MÉDIO', 'EXTREMO'] as const)[Math.floor(Math.random() * 3)],
              attendance: 6000 + Math.floor(Math.random() * 12000),
              storyline
            }
          });
        } finally {
          drawing = false;
        }
      },

      startScheduledMatch: () => {
        const schedule = get().nextMatchSchedule;
        if (!schedule) return;
        soundEffects.playWhistle('LONG');
        const incidents = getRandomIncidentsForMatch(schedule.home, schedule.away);
        set({
          currentManagerIncident: null,
          currentGoalAnimation: null,
          isEvaluatingPostMatch: false,
          postMatch: null,
          homeManagerEjected: false,
          awayManagerEjected: false,
          resolvedIncidentIds: [],
          liveStats: { ...INITIAL_STATS },
          activeMatch: {
            homeTeam: schedule.home,
            awayTeam: schedule.away,
            homeScore: 0,
            awayScore: 0,
            homeRedCards: 0,
            awayRedCards: 0,
            minute: 0,
            addedTime: 2 + Math.floor(Math.random() * 4),
            status: 'PLAYING',
            matchSpeed: 2,
            matchTemperature: 45,
            ticker: [`Apito inicial: ${schedule.home.name} x ${schedule.away.name}!`],
            scheduledIncidents: incidents,
            currentIncident: null,
            managerIncidentMinute: Math.random() < 0.7 ? 25 + Math.floor(Math.random() * 50) : null,
            matchRating: 8.4,
            decisionsHistory: [],
            report: {
              id: `match-${Date.now()}`,
              week: get().week,
              tier: get().referee.tier,
              stadium: schedule.stadium,
              homeTeamName: schedule.home.name,
              awayTeamName: schedule.away.name,
              homeScore: 0,
              awayScore: 0,
              uefaScore: 8.4,
              dateStr: `Rodada ${get().week} - Temporada Oficial`,
              attendance: schedule.attendance,
              pressHeadline: schedule.storyline.pressHeadline,
              matchStats: { ...INITIAL_STATS },
              decisionVerdicts: [],
              goals: [],
              cards: [],
              varReviews: []
            }
          }
        });
      },

      clearGoalAnimation: () => set({ currentGoalAnimation: null }),

      registerSprayUse: () => {
        const a = get().activeMatch;
        if (!a) return;
        set({
          activeMatch: {
            ...a,
            matchTemperature: Math.max(25, a.matchTemperature - 5),
            ticker: ['[SPRAY] Barreira demarcada a 9,15 m. Jogo organizado.', ...a.ticker]
          }
        });
      },

      setMatchSpeed: speed => {
        const a = get().activeMatch;
        if (a) set({ activeMatch: { ...a, matchSpeed: speed } });
      },

      updateMatchMinute: () => {
        const state = get();
        const a = state.activeMatch;
        if (!a || a.status !== 'PLAYING' || state.currentManagerIncident || state.currentGoalAnimation) return;

        const minute = a.minute + 1;
        const stats = { ...state.liveStats };
        stats.distanceCoveredKm = Number((stats.distanceCoveredKm + 0.11).toFixed(2));
        stats.refereeBpm = Math.round(112 + a.matchTemperature * 0.45 + Math.sin(minute) * 5);

        const incident = a.scheduledIncidents.find(i => i.minute === minute && !state.resolvedIncidentIds.includes(i.id));
        if (incident) {
          soundEffects.playRadioBeep();
          set({
            liveStats: stats,
            activeMatch: {
              ...a,
              minute,
              status: 'KMI_PAUSED',
              currentIncident: incident,
              matchTemperature: Math.min(100, a.matchTemperature + 15),
              ticker: [`${fmtMin(minute)}' ⚠️ LANCE CAPITAL: ${incident.title}`, ...a.ticker]
            }
          });
          return;
        }

        const { homeTeam, awayTeam, homeRedCards, awayRedCards } = a;
        const homeFactor = (homeTeam.attackStrength / awayTeam.defenseStrength) * (1 + (awayRedCards - homeRedCards) * 0.3);
        const awayFactor = (awayTeam.attackStrength / homeTeam.defenseStrength) * (1 + (homeRedCards - awayRedCards) * 0.3);
        const drift = (homeFactor - awayFactor) * 4 + (Math.random() - 0.5) * 4;
        stats.homePossession = clamp(Math.round(stats.homePossession + drift * 0.3 + (50 - stats.homePossession) * 0.05), 35, 65);
        stats.awayPossession = 100 - stats.homePossession;

        let homeScore = a.homeScore;
        let awayScore = a.awayScore;
        const ticker = [...a.ticker];
        const report = { ...a.report, goals: [...a.report.goals] };
        let goalSide: 'HOME' | 'AWAY' | null = null;

        for (const side of ['HOME', 'AWAY'] as const) {
          const isHome = side === 'HOME';
          const poss = isHome ? stats.homePossession : stats.awayPossession;
          const factor = (isHome ? homeFactor : awayFactor) * (poss / 50);
          if (Math.random() < 0.12 * factor) {
            if (isHome) stats.homeShots += 1;
            else stats.awayShots += 1;
            if (Math.random() < 0.45) {
              if (isHome) stats.homeShotsOnTarget += 1;
              else stats.awayShotsOnTarget += 1;
              if (!goalSide && Math.random() < 0.26) goalSide = side;
            }
          }
          if (Math.random() < 0.05 * (poss / 50)) {
            if (isHome) stats.homeCorners += 1;
            else stats.awayCorners += 1;
          }
          if (Math.random() < 0.035) {
            if (isHome) stats.homeOffsides += 1;
            else stats.awayOffsides += 1;
          }
        }
        if (Math.random() < 0.3) {
          const homeFoul = Math.random() < homeTeam.aggressionLevel / (homeTeam.aggressionLevel + awayTeam.aggressionLevel);
          if (homeFoul) stats.homeFouls += 1;
          else stats.awayFouls += 1;
        }

        let goalAnim: GoalAnimationData | null = null;
        let temperature = Math.max(25, a.matchTemperature - 0.5);
        if (goalSide) {
          if (goalSide === 'HOME') homeScore += 1;
          else awayScore += 1;
          const num = [7, 9, 10, 11, 8][Math.floor(Math.random() * 5)];
          report.goals.push({ minute, team: goalSide, playerNumber: num, isPenalty: false });
          goalAnim = buildGoalAnim({ ...a, homeScore, awayScore }, goalSide, minute, num, false, 'GOAL');
          ticker.unshift(`${fmtMin(minute)}' ⚽ GOL do ${goalSide === 'HOME' ? homeTeam.name : awayTeam.name}! ${homeScore}-${awayScore}`);
          temperature = Math.min(100, temperature + 10);
          soundEffects.playWhistle('SHORT');
        }

        let managerIncident: ManagerIncident | null = null;
        if (a.managerIncidentMinute === minute) {
          const homeOk = !state.homeManagerEjected;
          const awayOk = !state.awayManagerEjected;
          const side: 'HOME' | 'AWAY' | null = homeOk && awayOk ? (Math.random() < 0.5 ? 'HOME' : 'AWAY') : homeOk ? 'HOME' : awayOk ? 'AWAY' : null;
          if (side) {
            const pick = MANAGER_POOL[Math.floor(Math.random() * MANAGER_POOL.length)];
            const team = side === 'HOME' ? homeTeam : awayTeam;
            managerIncident = { minute, team: side, managerName: team.managerName, teamName: team.name, ...pick };
          }
        }

        if (minute === 45) ticker.unshift("45' Fim do 1º tempo. Bola rolando no 2º tempo.");
        if (minute === 90) ticker.unshift(`90' O 4º árbitro indica ${a.addedTime} minutos de acréscimo.`);

        if (minute >= 90 + a.addedTime) {
          soundEffects.playWhistle('TRIPLE');
          ticker.unshift(`${fmtMin(minute)}' Fim de partida! Apito final.`);
          set({
            liveStats: stats,
            currentGoalAnimation: goalAnim,
            activeMatch: { ...a, minute, homeScore, awayScore, report, ticker, status: 'FINISHED', matchTemperature: temperature }
          });
          void get().finalizeMatch();
          return;
        }

        set({
          liveStats: stats,
          currentGoalAnimation: goalAnim,
          currentManagerIncident: managerIncident,
          activeMatch: {
            ...a,
            minute,
            homeScore,
            awayScore,
            report,
            ticker,
            matchTemperature: temperature,
            managerIncidentMinute: managerIncident ? null : a.managerIncidentMinute
          }
        });
      },

      openVarRadioIntercom: () => {
        soundEffects.playRadioBeep();
        const a = get().activeMatch;
        if (a) set({ activeMatch: { ...a, status: 'VAR_RADIO' } });
      },

      openVarMonitorOFR: () => {
        const a = get().activeMatch;
        if (a) set({ activeMatch: { ...a, status: 'VAR_ACTIVE' } });
      },

      resolveIncident: (decision, viaVar) => {
        const state = get();
        const a = state.activeMatch;
        if (!a || !a.currentIncident) return;
        const incId = a.currentIncident.id;
        const res = applyIncidentDecision(a, decision, viaVar);
        const stats = { ...state.liveStats };
        if (res.foulSide === 'HOME') stats.homeFouls += 1;
        if (res.foulSide === 'AWAY') stats.awayFouls += 1;
        soundEffects.playWhistle(decision.includes('RED') ? 'TRIPLE' : 'LONG');
        const heat = decision.includes('RED') || decision === 'GOAL_DISALLOWED' ? 10 : 0;
        set({
          resolvedIncidentIds: [...state.resolvedIncidentIds, incId],
          liveStats: stats,
          currentGoalAnimation: res.goalAnim,
          activeMatch: { ...res.match, matchTemperature: clamp(res.match.matchTemperature + heat, 20, 100) }
        });
      },

      triggerInstantFieldDecision: async () => {
        const a = get().activeMatch;
        if (!a || !a.currentIncident) return;
        get().resolveIncident(a.currentIncident.fieldDecision, false);
      },

      confirmFinalDecision: async decision => {
        get().resolveIncident(decision, true);
      },

      resolveManagerIncident: action => {
        const state = get();
        const mi = state.currentManagerIncident;
        const a = state.activeMatch;
        if (!mi || !a) return;
        const ideal = mi.intensity === 'MODERADA' ? 'VERBAL_WARNING' : mi.intensity === 'ACINTOSA' ? 'YELLOW_CARD' : 'RED_CARD';
        const report = { ...a.report, cards: [...a.report.cards] };
        if (action !== 'VERBAL_WARNING') {
          report.cards.push({
            minute: mi.minute,
            team: mi.team,
            targetType: 'MANAGER',
            targetLabel: `Técnico ${mi.managerName}`,
            cardType: action === 'RED_CARD' ? 'RED' : 'YELLOW',
            reason: mi.reason
          });
        }
        soundEffects.playWhistle(action === 'RED_CARD' ? 'TRIPLE' : 'SHORT');
        const label = action === 'VERBAL_WARNING' ? 'advertência verbal' : action === 'YELLOW_CARD' ? 'cartão amarelo' : 'EXPULSÃO';
        set({
          currentManagerIncident: null,
          homeManagerEjected: state.homeManagerEjected || (action === 'RED_CARD' && mi.team === 'HOME'),
          awayManagerEjected: state.awayManagerEjected || (action === 'RED_CARD' && mi.team === 'AWAY'),
          activeMatch: {
            ...a,
            report,
            matchRating: clamp(a.matchRating + (action === ideal ? 0.08 : -0.2), 4, 10),
            matchTemperature: clamp(a.matchTemperature + (action === 'VERBAL_WARNING' ? -8 : action === 'RED_CARD' ? 6 : -2), 20, 100),
            ticker: [`${fmtMin(a.minute)}' 🧑‍💼 Área técnica (${mi.teamName}): ${label}.`, ...a.ticker]
          }
        });
      },

      finalizeMatch: async () => {
        const state = get();
        const a = state.activeMatch;
        if (!a) return;
        const uefaScore = Number(clamp(a.matchRating, 4, 10).toFixed(2));
        const base: MatchReport = {
          ...a.report,
          homeScore: a.homeScore,
          awayScore: a.awayScore,
          uefaScore,
          matchStats: { ...state.liveStats }
        };
        set({ isEvaluatingPostMatch: true, postMatch: { report: base, uefaScore } });
        const media = await generateComprehensivePostMatchMedia(
          a.homeTeam.name,
          a.awayTeam.name,
          `${a.homeScore}x${a.awayScore}`,
          uefaScore,
          state.referee.name,
          a.decisionsHistory,
          state.referee.geminiApiKey
        );
        const cur = get().postMatch;
        if (!cur) return;
        set({
          isEvaluatingPostMatch: false,
          postMatch: {
            uefaScore,
            report: {
              ...cur.report,
              mediaMesaRedonda: media.mediaMesaRedonda,
              decisionVerdicts: media.decisionVerdicts,
              pressHeadline: media.mediaMesaRedonda.headline
            }
          }
        });
      },

      finishMatch: async () => {
        const state = get();
        const a = state.activeMatch;
        const pm = state.postMatch;
        if (!a || !pm) return;
        const prev = state.referee;
        const yellow = pm.report.cards.filter(c => c.cardType === 'YELLOW').length;
        const red = pm.report.cards.filter(c => c.cardType === 'RED').length;
        const matches = prev.stats.matches + 1;
        const avg = prev.stats.matches === 0 ? pm.uefaScore : (prev.uefaAverageScore * prev.stats.matches + pm.uefaScore) / matches;
        set({
          matchHistory: [pm.report, ...state.matchHistory],
          teams: applyResult(state.teams, a.homeTeam, a.awayTeam, a.homeScore, a.awayScore),
          referee: {
            ...prev,
            uefaAverageScore: Number(avg.toFixed(2)),
            reputation: clamp(prev.reputation + (pm.uefaScore >= 8.35 ? 2 : -2), 0, 100),
            stats: {
              matches,
              yellowCards: prev.stats.yellowCards + yellow,
              redCards: prev.stats.redCards + red,
              penalties: prev.stats.penalties + pm.report.goals.filter(g => g.isPenalty).length,
              varInterventions: prev.stats.varInterventions + pm.report.varReviews.length
            }
          },
          week: state.week + 1,
          activeMatch: null,
          postMatch: null,
          currentGoalAnimation: null,
          currentManagerIncident: null,
          liveStats: { ...INITIAL_STATS },
          nextMatchSchedule: null
        });
      },

      resetCareer: () => {
        localStorage.removeItem('o-apito-save');
        window.location.reload();
      }
    }),
    {
      name: 'o-apito-save',
      partialize: s => ({
        isProfileCreated: s.isProfileCreated,
        week: s.week,
        referee: s.referee,
        teams: s.teams,
        matchHistory: s.matchHistory
      })
    }
  )
);
</file>

