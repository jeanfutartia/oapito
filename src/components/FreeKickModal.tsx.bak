import type { FreeKick } from '../store/useGameStore';

interface Props {
  fk: FreeKick;
  atkName: string;
  defName: string;
  wallColor: string;
  spray: number;
  onMark: () => void;
  onWarn: () => void;
  onAuthorize: () => void;
}

const PX = 5; // pixels por metro
const WALL = 9.15;

export const FreeKickModal = ({ fk, atkName, defName, wallColor, spray, onMark, onWarn, onAuthorize }: Props) => {
  const ballY = 16 + fk.dist * PX;
  const wallY = ballY - fk.wallDist * PX;
  const lineY = ballY - WALL * PX;
  const bad = !fk.marked && fk.wallDist < WALL - 0.3;
  return (
    <div className="fixed inset-0 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 z-50 font-sans">
      <div className="bg-slate-900 border-2 border-sky-500 rounded-2xl max-w-xl w-full p-4 sm:p-6 shadow-2xl text-slate-100 flex flex-col gap-3">
        <div className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
          <span className="bg-sky-500 text-black font-black text-xs px-2.5 py-1 rounded uppercase tracking-wider">🎯 Falta perigosa • {fk.minute}'</span>
          <span className="text-xs text-slate-400">{atkName} cobra • falta de {fk.foulerName} ({defName})</span>
        </div>

        <svg viewBox="0 0 320 196" className="w-full rounded-xl border border-slate-800 bg-emerald-900">
          <rect x="0" y="0" width="320" height="196" fill="#14532d" />
          {[0, 1, 2, 3, 4, 5].map(i => <rect key={i} x={i * 53.4} y="0" width="26.7" height="196" fill="rgba(255,255,255,0.04)" />)}
          <rect x="95" y="0" width="130" height="62" fill="none" stroke="rgba(255,255,255,0.5)" strokeWidth="1.5" />
          <rect x="128" y="2" width="64" height="9" fill="none" stroke="#fff" strokeWidth="2" />
          <line x1="40" y1={lineY} x2="280" y2={lineY} stroke={fk.marked ? '#ffffff' : 'rgba(255,255,255,0.18)'} strokeWidth="2" strokeDasharray={fk.marked ? '0' : '4 4'} />
          <text x="284" y={lineY + 4} fontSize="9" fill={fk.marked ? '#fff' : 'rgba(255,255,255,0.4)'}>9,15 m</text>
          <g style={{ transform: 'translate(0px, ' + wallY + 'px)', transition: 'transform .7s ease' }}>
            {[0, 1, 2, 3, 4].map(i => <circle key={i} cx={134 + i * 13} cy="0" r="6" fill={wallColor} stroke="#fff" strokeWidth="1.5" />)}
          </g>
          <circle cx="160" cy={ballY} r="5" fill="#fff" stroke="#111" strokeWidth="1.5" />
          <circle cx="146" cy={ballY + 12} r="6" fill="#facc15" stroke="#111" strokeWidth="1.5" />
          <text x="8" y="188" fontSize="10" fill="#bbf7d0">Distância do gol: {fk.dist} m</text>
        </svg>

        <div className={'rounded-xl border p-3 text-xs ' + (bad ? 'border-red-700 bg-red-950/40 text-red-200' : fk.marked ? 'border-emerald-700 bg-emerald-950/40 text-emerald-200' : 'border-slate-700 bg-slate-950 text-slate-300')}>
          Barreira a <b>{fk.wallDist.toFixed(1).replace('.', ',')} m</b> da bola (a regra manda 9,15 m).{' '}
          {bad ? 'Está adiantada! Demarque com o spray ou mande recuar antes de apitar.' : fk.marked ? 'Linha demarcada: a barreira não pode cruzá-la.' : 'Ajuste a barreira antes de autorizar a cobrança.'}
          {fk.note && <span className="block mt-1 font-bold">{fk.note}</span>}
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-3 gap-2">
          <button onClick={onMark} disabled={fk.marked} className="p-3 bg-indigo-600 hover:bg-indigo-500 disabled:opacity-40 rounded-xl text-xs font-bold flex flex-col items-center gap-0.5 transition">
            <span className="text-base">🥫 Spray</span><span className="text-[10px] font-normal opacity-80">Marcar 9,15 m • restam {spray}</span>
          </button>
          <button onClick={onWarn} disabled={fk.marked || fk.warned} className="p-3 bg-slate-800 hover:bg-slate-700 border border-slate-700 disabled:opacity-40 rounded-xl text-xs font-bold flex flex-col items-center gap-0.5 transition">
            <span className="text-base">🗣️ Recuar</span><span className="text-[10px] font-normal opacity-80">Aviso verbal (1 uso)</span>
          </button>
          <button onClick={onAuthorize} className="p-3 bg-emerald-600 hover:bg-emerald-500 rounded-xl text-xs font-bold flex flex-col items-center gap-0.5 transition shadow-lg shadow-emerald-600/30">
            <span className="text-base">📢 Apitar</span><span className="text-[10px] font-normal opacity-80">Autorizar a cobrança</span>
          </button>
        </div>
      </div>
    </div>
  );
};
