import { useState } from 'react';
import { soundEffects } from '../services/soundEffects';

interface Props {
  bpm: number;
  distanceKm: number;
  temperature: number;
  onSprayUsed: () => void;
}

export const SmartRefereeDashboard = ({ bpm, distanceKm, temperature, onSprayUsed }: Props) => {
  const [sprayActive, setSprayActive] = useState(false);
  const [sprayLineDrawn, setSprayLineDrawn] = useState(false);

  const handleUseSpray = () => {
    soundEffects.playWhistle('SHORT');
    setSprayActive(true);
    setTimeout(() => {
      setSprayLineDrawn(true);
      setSprayActive(false);
      onSprayUsed();
    }, 1000);
  };

  return (
    <div className="bg-gradient-to-b from-slate-900 to-slate-950 border border-slate-800 rounded-2xl p-4 shadow-2xl flex flex-col gap-4 font-mono text-xs">
      <div className="flex items-center justify-between border-b border-slate-800 pb-3">
        <div className="flex items-center gap-2">
          <div className="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping" />
          <span className="font-black text-slate-100 uppercase text-xs tracking-wider">
            FIFA SMARTWATCH TELEMETRY
          </span>
        </div>
        <span className="text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800 px-2 py-0.5 rounded font-bold">
          LIVE SYNC
        </span>
      </div>

      {/* Grid Biométrico Profissional */}
      <div className="grid grid-cols-3 gap-3">
        <div className="bg-slate-950/80 p-3 rounded-xl border border-slate-800/80 flex flex-col items-center justify-center">
          <span className="text-[10px] text-slate-400 mb-1">CARDIO (BPM)</span>
          <div className="flex items-center gap-1.5">
            <span className="text-base">❤️</span>
            <span className={`text-base font-black ${bpm > 150 ? 'text-red-400 animate-pulse' : 'text-emerald-400'}`}>
              {bpm}
            </span>
          </div>
        </div>

        <div className="bg-slate-950/80 p-3 rounded-xl border border-slate-800/80 flex flex-col items-center justify-center">
          <span className="text-[10px] text-slate-400 mb-1">DISTÂNCIA</span>
          <div className="flex items-center gap-1.5">
            <span className="text-base">🏃</span>
            <span className="text-base font-black text-cyan-400">
              {distanceKm.toFixed(2)}<span className="text-[10px] text-slate-400">km</span>
            </span>
          </div>
        </div>

        <div className="bg-slate-950/80 p-3 rounded-xl border border-slate-800/80 flex flex-col items-center justify-center">
          <span className="text-[10px] text-slate-400 mb-1">PRESSÃO</span>
          <div className="flex items-center gap-1.5">
            <span className="text-base">🔥</span>
            <span className={`text-base font-black ${temperature > 70 ? 'text-amber-400' : 'text-slate-300'}`}>
              {temperature}%
            </span>
          </div>
        </div>
      </div>

      {/* Barra de Esforço Físico */}
      <div className="bg-slate-950 p-2.5 rounded-xl border border-slate-800 flex flex-col gap-1.5">
        <div className="flex justify-between text-[10px] text-slate-400">
          <span>Desgaste Físico da Partida</span>
          <span className="text-emerald-400 font-bold">{Math.min(100, Math.floor(distanceKm * 9))}%</span>
        </div>
        <div className="w-full bg-slate-900 h-2 rounded-full overflow-hidden border border-slate-800">
          <div 
            className="bg-gradient-to-r from-emerald-500 to-cyan-500 h-full transition-all duration-300" 
            style={{ width: `${Math.min(100, distanceKm * 9)}%` }} 
          />
        </div>
      </div>

      {/* Ferramentas do Árbitro em Campo */}
      <div className="pt-1 flex items-center gap-2">
        <button
          onClick={handleUseSpray}
          disabled={sprayActive}
          className={`flex-1 py-2.5 px-3 rounded-xl font-bold text-[11px] transition flex items-center justify-center gap-2 ${
            sprayLineDrawn 
              ? 'bg-slate-800 text-emerald-400 border border-emerald-700/60' 
              : 'bg-indigo-600 hover:bg-indigo-500 text-white shadow-lg shadow-indigo-600/30'
          }`}
        >
          <span>💨</span>
          <span>{sprayActive ? 'Marcando 9,15m...' : sprayLineDrawn ? 'Barreira Pronta ✓' : 'Spray de Barreira'}</span>
        </button>

        <button
          onClick={() => soundEffects.playWhistle('LONG')}
          className="py-2.5 px-3 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl text-slate-200 font-bold text-[11px] transition flex items-center gap-1.5"
        >
          <span>📢</span>
          <span>Apito</span>
        </button>
      </div>
    </div>
  );
};
