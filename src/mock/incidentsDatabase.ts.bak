const rand = (min: number, max: number) => Math.floor(Math.random() * (max - min + 1)) + min;

export function getRandomIncidentsForMatch(home: Team, away: Team): Incident[] {
  const selected = [...TEMPLATES].sort(() => Math.random() - 0.5).slice(0, 3);
  const minutes = [rand(14, 38), rand(48, 68), rand(74, 88)];

  return selected.map((tpl, idx) => {
    const attIsHome = Math.random() < 0.5;
    const att = attIsHome ? home : away;
    const def = attIsHome ? away : home;
    const attackingTeam: 'HOME' | 'AWAY' = attIsHome ? 'HOME' : 'AWAY';
    const defendingTeam: 'HOME' | 'AWAY' = attIsHome ? 'AWAY' : 'HOME';
    const offendingTeam = tpl.offenderSide === 'ATT' ? attackingTeam : defendingTeam;

    return {
      id: `incident-${Date.now()}-${idx}`,
      minute: minutes[idx],
      category: tpl.category,
      title: tpl.title(att, def),
      description: tpl.description(att, def),
      context: tpl.context,
      pitchZone: { ...tpl.zone, xPercent: attIsHome ? tpl.zone.xPercent : 100 - tpl.zone.xPercent },
      offendingTeam,
      attackingTeam,
      offendingPlayerNumber: tpl.offender,
      victimPlayerNumber: tpl.victim,
      recommendedVarDecision: tpl.recommended,
      acceptableDecisions: tpl.acceptable,
      fieldDecision: tpl.fieldDecision,
      goalPending: tpl.goalPending,
      ifabExplanation: tpl.ifab,
      defaultVarDialogue: tpl.dialogue,
      scene: tpl.scene,
      offside: tpl.offside
    };
  });
}
