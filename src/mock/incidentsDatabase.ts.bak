import type {
  DecisionType,
  Incident,
  IncidentCategory,
  IncidentPitchZone,
  IncidentScene,
  OffsideData,
  ScenePlayer,
  Team
} from '../types/types';

type XY = [number, number];

export const DECISION_LABEL: Record<DecisionType, string> = {
  PLAY_ON: 'Seguir o jogo',
  FOUL: 'Falta simples',
  YELLOW_CARD: 'Cartão amarelo',
  RED_CARD: 'Cartão vermelho',
  PENALTY: 'Pênalti',
  PENALTY_YELLOW: 'Pênalti + amarelo',
  PENALTY_RED: 'Pênalti + vermelho',
  GOAL_VALID: 'Gol válido',
  GOAL_DISALLOWED: 'Gol anulado'
};

const pl = (
  id: string,
  side: 'ATT' | 'DEF',
  number: number,
  role: string,
  from: XY,
  to: XY,
  extra: Partial<ScenePlayer> = {}
): ScenePlayer => ({ id, side, number, role, from, to, ...extra });

const GK: ScenePlayer = pl('gk', 'DEF', 1, 'GOLEIRO', [104, 34], [104, 34], { gk: true });

const offsideData = (kickFrame: number, deltaCmAtKick: number): OffsideData => ({
  kickFrame,
  deltaCmAtKick,
  closingCmPerFrame: 3,
  passerNumber: 8,
  attackerNumber: 9,
  defenderNumber: 3,
  attackerParts: [
    { name: 'Ombro', offsetCm: -24, legal: true },
    { name: 'Joelho', offsetCm: -9, legal: true },
    { name: 'Pé', offsetCm: 0, legal: true },
    { name: 'Mão/Braço', offsetCm: 14, legal: false }
  ],
  defenderParts: [
    { name: 'Chuteira', offsetCm: 0, legal: true },
    { name: 'Joelho', offsetCm: -7, legal: true },
    { name: 'Ombro', offsetCm: -27, legal: true }
  ]
});

interface Template {
  category: IncidentCategory;
  title: (att: Team, def: Team) => string;
  description: (att: Team, def: Team) => string;
  context: string;
  recommended: DecisionType;
  acceptable: DecisionType[];
  fieldDecision: DecisionType;
  goalPending: boolean;
  offenderSide: 'ATT' | 'DEF';
  offender: number;
  victim: number;
  ifab: string;
  dialogue: string;
  zone: IncidentPitchZone;
  scene?: IncidentScene;
  offside?: OffsideData;
}

